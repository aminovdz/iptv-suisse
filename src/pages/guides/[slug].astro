---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { Calendar, Clock, User, ArrowLeft, ShieldCheck, Zap, MessageCircle, ArrowRight } from 'lucide-astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props;
const { Content } = await guide.render();

const pageTitle = `${guide.data.title} — IPTV Suisse`;
const pageDescription = guide.data.description;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": guide.data.title,
  "description": guide.data.description,
  "author": {
    "@type": "Person",
    "name": guide.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "IPTV Suisse",
    "url": "https://iptvsuisse.it.com"
  },
  "datePublished": guide.data.pubDate.toISOString(),
  "dateModified": (guide.data.updatedDate || guide.data.pubDate).toISOString(),
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://iptvsuisse.it.com/guides/${guide.slug}`
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={`/guides/${guide.slug}`}
  type="article"
  publishedTime={guide.data.pubDate.toISOString()}
  schema={articleSchema}
>
  <StickyHeader />

  <main class="min-h-screen pt-32 pb-24 bg-[#0B0C10] text-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back Link -->
      <div class="mb-8">
        <a
          href="/guides"
          class="inline-flex items-center gap-2 text-xs font-semibold text-gray-400 hover:text-white transition-colors"
        >
          <ArrowLeft class="w-4 h-4" />
          <span>Retour à tous les guides</span>
        </a>
      </div>

      <!-- Article Header -->
      <header class="border-b border-white/[0.08] pb-10 mb-10">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-bold uppercase tracking-wider mb-4">
          <ShieldCheck class="w-4 h-4" />
          <span>{guide.data.category}</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-6">
          {guide.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-xs text-gray-400">
          <span class="flex items-center gap-1.5">
            <User class="w-3.5 h-3.5 text-gray-400" />
            <span class="text-gray-200 font-medium">{guide.data.author}</span>
          </span>
          <span>·</span>
          <span class="flex items-center gap-1.5">
            <Calendar class="w-3.5 h-3.5 text-gray-400" />
            <span>{guide.data.pubDate.toLocaleDateString('fr-CH', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          </span>
          <span>·</span>
          <span class="flex items-center gap-1.5">
            <Clock class="w-3.5 h-3.5 text-gray-400" />
            <span>{guide.data.readingTime}</span>
          </span>
        </div>
      </header>

      <!-- Markdown Article Content -->
      <article class="prose prose-invert prose-red max-w-none prose-headings:font-bold prose-headings:text-white prose-p:text-gray-300 prose-p:leading-relaxed prose-strong:text-white prose-li:text-gray-300 prose-blockquote:border-[#DC2626] prose-blockquote:bg-white/[0.02] prose-blockquote:py-2 prose-blockquote:px-4 prose-blockquote:rounded-r-xl">
        <Content />
      </article>

      <!-- Bottom Author & Conversion Box -->
      <div class="mt-16 pt-10 border-t border-white/[0.08]">
        <div class="p-8 rounded-3xl bg-gradient-to-br from-[#161926] via-[#11131C] to-[#161926] border border-white/[0.08] relative overflow-hidden shadow-2xl">
          <div class="flex flex-col md:flex-row items-center justify-between gap-6">
            <div>
              <div class="inline-flex items-center gap-2 text-xs font-bold text-amber-400 uppercase tracking-wider mb-2">
                <Zap class="w-4 h-4" />
                <span>Testez la Différence IPTV Suisse</span>
              </div>
              <h3 class="text-xl sm:text-2xl font-black text-white mb-2">
                Prêt à Passer au Streaming 4K Sans Coupure ?
              </h3>
              <p class="text-xs sm:text-sm text-gray-300 max-w-xl">
                Rejoignez des milliers de clients satisfaits en Suisse dès <strong>CHF 8.-</strong> ou optez pour notre formule annuelle recommandée à <strong>CHF 55.-/an</strong> (~CHF 4.58/mois).
              </p>
            </div>

            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto shrink-0">
              <a
                href="/#pricing"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-[#DC2626] to-[#EF4444] text-white font-bold text-xs shadow-lg shadow-red-900/30 hover:scale-[1.02] transition-transform"
              >
                <span>Voir les Offres (CHF 55.-)</span>
                <ArrowRight class="w-4 h-4" />
              </a>

              <a
                href="https://wa.me/18036582620?text=Bonjour,%20suite%20à%20la%20lecture%20du%20guide,%20je%20souhaite%20un%20test%2024h"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.1] border border-white/[0.1] text-white font-bold text-xs transition-colors"
              >
                <MessageCircle class="w-4 h-4 text-emerald-400" />
                <span>Test 24h WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
