---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import { BookOpen, Clock, Calendar, ArrowRight, Sparkles } from 'lucide-astro';

const allGuides = await getCollection('guides');
allGuides.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const pageTitle = "Guides & Tutoriels IPTV Suisse — Conseils d'Experts & Légalité";
const pageDescription = "Découvrez tous nos guides d'experts sur l'IPTV en Suisse : analyses juridiques (LDA Art. 19), tutoriels Smart TV Samsung & LG, et streaming sport 4K.";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/guides"
  keywords={["guides iptv suisse", "tutoriel iptv suisse", "legalite streaming suisse", "configurer iptv suisse"]}
>
  <StickyHeader />

  <main class="min-h-screen pt-32 pb-24 bg-[#0B0C10] text-gray-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-bold uppercase tracking-wider mb-4">
          <BookOpen class="w-4 h-4" />
          <span>Centre de Ressources & Savoir 🇨🇭</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
          Guides, Tutoriels & Analyses <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#EF4444]">IPTV Suisse</span>
        </h1>
        <p class="text-base text-gray-400">
          Nos experts techniques et juridiques vous expliquent tout : installation sur Smart TV, législation suisse du droit d'auteur (LDA Art. 19) et optimisation 4K pour le sport.
        </p>
      </div>

      <!-- Guides Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {allGuides.map((guide) => (
          <article class="flex flex-col justify-between rounded-3xl bg-[#12141D] border border-white/[0.08] p-6 sm:p-7 hover:border-[#DC2626]/40 transition-all duration-300 hover:-translate-y-1 shadow-xl">
            <div>
              <!-- Category & Read Time -->
              <div class="flex items-center justify-between gap-2 mb-4 text-xs">
                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/[0.05] border border-white/[0.08] text-amber-400 font-semibold">
                  <Sparkles class="w-3 h-3" />
                  {guide.data.category}
                </span>
                <span class="flex items-center gap-1 text-gray-400 font-medium">
                  <Clock class="w-3.5 h-3.5" />
                  {guide.data.readingTime}
                </span>
              </div>

              <!-- Featured Image with Alt -->
              {guide.data.image && (
                <a href={`/guides/${guide.slug}`} class="block mb-4 overflow-hidden rounded-2xl border border-white/[0.08]">
                  <img
                    src={guide.data.image}
                    alt={guide.data.imageAlt || guide.data.title}
                    class="w-full h-44 object-cover hover:scale-105 transition-transform duration-300"
                    width="600"
                    height="350"
                    loading="lazy"
                  />
                </a>
              )}

              <!-- Title -->
              <h2 class="text-lg sm:text-xl font-bold text-white mb-3 leading-snug line-clamp-2 hover:text-[#DC2626] transition-colors">
                <a href={`/guides/${guide.slug}`}>
                  {guide.data.title}
                </a>
              </h2>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-gray-400 line-clamp-3 mb-6 leading-relaxed">
                {guide.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs">
              <span class="flex items-center gap-1.5 text-gray-400">
                <Calendar class="w-3.5 h-3.5" />
                {guide.data.pubDate.toLocaleDateString('fr-CH', { day: 'numeric', month: 'short', year: 'numeric' })}
              </span>

              <a
                href={`/guides/${guide.slug}`}
                class="inline-flex items-center gap-1.5 text-[#60A5FA] hover:text-white font-bold group"
              >
                <span>Lire l'article</span>
                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
