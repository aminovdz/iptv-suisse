];

// Fallback for football if API is unreachable
if (liveMatches.length === 0) {
  liveMatches = [
    {
      id: "ch-yb-thun",
      category: 'super-league',
      sport: "⚽ Football",
      league: "Super League Suisse",
      badge: "SUPER LEAGUE 🇨🇭",
      homeTeam: "BSC Young Boys",
      awayTeam: "FC Thun",
      scoreHome: 4,
      scoreAway: 2,
      status: "finished",
      statusDetail: "Terminé",
      timeOrDate: "FT · Score Officiel",
      venue: "Wankdorf Stadion (Berne)",
      quality: "4K UHD 60FPS",
      hot: true
    },
    {
      id: "ch-basel-luzern",
      category: 'super-league',
      sport: "⚽ Football",
      league: "Super League Suisse",
      badge: "SUPER LEAGUE 🇨🇭",
      homeTeam: "FC Basel",
      awayTeam: "FC Luzern",
      scoreHome: 1,
      scoreAway: 2,
      status: "finished",
      statusDetail: "Terminé",
      timeOrDate: "FT · Score Officiel",
      venue: "St. Jakob-Park (Bâle)",
      quality: "4K UHD 60FPS"
    },
    {
      id: "ch-sion-lausanne",
      category: 'super-league',
      sport: "⚽ Football",
      league: "Super League Suisse",
      badge: "DERBY DU RHÔNE 🇨🇭",
      homeTeam: "FC Sion",
      awayTeam: "Lausanne-Sport",
      scoreHome: 0,
      scoreAway: 0,
      status: "finished",
