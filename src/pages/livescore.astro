---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import ExitPopup from '../components/ExitPopup.astro';
import SocialPopup from '../components/SocialPopup.astro';
import { 
  Activity, 
  Tv, 
  RefreshCw, 
  Trophy, 
  Flame, 
  Play, 
  ArrowRight,
  Clock,
  MapPin
} from 'lucide-astro';

const currentYear = new Date().getFullYear();

const pageTitle = `Match Center & Scores en Direct ${currentYear} — IPTV Suisse 4K Sport Direct`;
const pageDescription = "Suivez tous les scores en direct, calendriers et classements des sports suisses : Super League de football, National League de Hockey et Ski Alpin en 4K Ultra HD à 60 FPS sans coupure.";
const pageKeywords = [
  "match center suisse",
  "score en direct suisse",
  "livescore iptv suisse",
  "national league score direct",
  "super league suisse live",
  "streaming sport 4k suisse",
  "regarder hockey suisse direct"
];

interface MatchItem {
  id: string;
  category: 'super-league' | 'national-league' | 'champions-league' | 'ski' | 'europe';
  sport: string;
  league: string;
  badge: string;
  homeTeam: string;
  awayTeam: string;
  homeLogo?: string;
  awayLogo?: string;
  scoreHome: number | string | null;
  scoreAway: number | string | null;
  status: 'live' | 'upcoming' | 'finished';
  statusDetail: string;
  timeOrDate: string;
  venue: string;
  quality: string;
  hot?: boolean;
}

let liveMatches: MatchItem[] = [];

// Fetch live football scores from ESPN API
try {
  const [suiRes, uefaRes] = await Promise.all([
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/sui.1/scoreboard", { signal: AbortSignal.timeout(3500) }),
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard", { signal: AbortSignal.timeout(3500) })
  ]);

  if (suiRes.ok) {
    const suiData = await suiRes.json();
    if (suiData.events && Array.isArray(suiData.events)) {
      for (const ev of suiData.events.slice(0, 4)) {
        const comp = ev.competitions?.[0];
        const homeComp = comp?.competitors?.[0];
        const awayComp = comp?.competitors?.[1];
        const state = ev.status?.type?.state;
        const statusType: 'live' | 'upcoming' | 'finished' = 
          state === 'in' ? 'live' : (state === 'post' ? 'finished' : 'upcoming');
        
        liveMatches.push({
          id: String(ev.id || Math.random()),
          category: 'super-league',
          sport: "⚽ Football",
          league: "Credit Suisse Super League",
          badge: "SUPER LEAGUE 🇨🇭",
          homeTeam: homeComp?.team?.displayName || "Équipe 1",
          awayTeam: awayComp?.team?.displayName || "Équipe 2",
          scoreHome: homeComp?.score !== undefined ? homeComp.score : (statusType === 'upcoming' ? null : 0),
          scoreAway: awayComp?.score !== undefined ? awayComp.score : (statusType === 'upcoming' ? null : 0),
          status: statusType,
          statusDetail: ev.status?.type?.detail || "Match Officiel",
          timeOrDate: ev.status?.type?.shortDetail || "Direct",
          venue: comp?.venue?.fullName ? `${comp.venue.fullName} (${comp.venue.address?.city || 'Suisse'})` : "Stade Suisse",
          quality: "4K UHD 60FPS",
          hot: true
        });
      }
    }
  }

  if (uefaRes.ok) {
    const uefaData = await uefaRes.json();
    if (uefaData.events && Array.isArray(uefaData.events)) {
      for (const ev of uefaData.events.slice(0, 2)) {
        const comp = ev.competitions?.[0];
        const homeComp = comp?.competitors?.[0];
        const awayComp = comp?.competitors?.[1];
        const state = ev.status?.type?.state;
        const statusType: 'live' | 'upcoming' | 'finished' = 
          state === 'in' ? 'live' : (state === 'post' ? 'finished' : 'upcoming');

        liveMatches.push({
          id: String(ev.id || Math.random()),
          category: 'champions-league',
          sport: "⚽ Football",
          league: "UEFA Champions League",
          badge: "CHAMPIONS LEAGUE 🏆",
          homeTeam: homeComp?.team?.displayName || "Équipe Europe 1",
          awayTeam: awayComp?.team?.displayName || "Équipe Europe 2",
          scoreHome: homeComp?.score !== undefined ? homeComp.score : (statusType === 'upcoming' ? null : 0),
          scoreAway: awayComp?.score !== undefined ? awayComp.score : (statusType === 'upcoming' ? null : 0),
          status: statusType,
          statusDetail: ev.status?.type?.detail || "Phase Finale",
          timeOrDate: ev.status?.type?.shortDetail || "Direct",
          venue: comp?.venue?.fullName || "Grand Stade Européen",
          quality: "4K UHD 60FPS",
          hot: true
        });
      }
    }
  }
} catch (err) {
  // Silent catch
}

// Ensure rich Swiss Sport catalog with National League & Ski Alpin
const staticSwissSports: MatchItem[] = [
