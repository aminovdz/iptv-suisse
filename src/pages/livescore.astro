      venue: "Stade de Tourbillon (Sion)",
      quality: "4K UHD 60FPS"
    }
  ];
}

const allMatches = [...liveMatches, ...staticSwissSports];

const standingsSuperLeague = [
  { rank: 1, team: "BSC Young Boys", pld: 24, gd: "+28", pts: 52 },
  { rank: 2, team: "Servette FC", pld: 24, gd: "+18", pts: 47 },
  { rank: 3, team: "FC Lugano", pld: 24, gd: "+12", pts: 44 },
  { rank: 4, team: "FC Zürich", pld: 24, gd: "+8", pts: 39 },
  { rank: 5, team: "FC St. Gallen", pld: 24, gd: "+5", pts: 36 },
  { rank: 6, team: "FC Luzern", pld: 24, gd: "-1", pts: 34 }
];

const standingsNationalLeague = [
  { rank: 1, team: "ZSC Lions", pld: 46, gd: "+51", pts: 98 },
  { rank: 2, team: "Fribourg-Gottéron", pld: 46, gd: "+38", pts: 91 },
  { rank: 3, team: "Lausanne HC", pld: 46, gd: "+29", pts: 86 },
  { rank: 4, team: "EV Zug", pld: 46, gd: "+21", pts: 82 },
  { rank: 5, team: "SC Bern", pld: 46, gd: "+10", pts: 79 },
  { rank: 6, team: "Genève-Servette HC", pld: 46, gd: "+7", pts: 74 }
];

const matchCenterSchema = {
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": "Match Center en Direct — Compétitions Sportives Suisses",
  "description": pageDescription,
  "sport": ["Soccer", "Ice Hockey", "Alpine Skiing"],
  "location": {
    "@type": "Place",
    "name": "Suisse (Confédération Helvétique)"
  },
  "organizer": {
    "@type": "Organization",
    "name": "IPTV Suisse",
    "url": "https://iptvsuisse.it.com"
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/livescore"
  keywords={pageKeywords}
  schema={matchCenterSchema}
>
  <StickyHeader currentPath="/livescore" />

  <main class="min-h-screen pt-28 pb-24 bg-[#0B0C10] text-gray-200">
    
    <!-- Top Hero Banner: Match Center Status -->
    <section class="relative py-12 md:py-16 overflow-hidden border-b border-white/[0.08]">
      <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-[#DC2626]/18 via-[#2563EB]/10 to-transparent rounded-full blur-[140px]"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
          <div>
            <!-- Live Pulse Badge -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-black uppercase tracking-wider mb-4">
              <span class="w-2 h-2 rounded-full bg-[#DC2626] animate-ping"></span>
              <Activity class="w-3.5 h-3.5" />
              <span>Match Center Officiel 🇨🇭 En Direct 4K</span>
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight leading-tight">
              Scores en Direct &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#EF4444] to-[#F59E0B]">Flux Sport 4K</span>
            </h1>

            <p class="text-gray-300 text-sm sm:text-base mt-3 max-w-2xl font-normal leading-relaxed">
              Consultez en temps réel les scores de la <strong>Super League de football</strong>, de la <strong>National League de hockey sur glace</strong> et de la <strong>Coupe du Monde de Ski Alpin</strong>. Regardez tous ces matchs en <strong>4K Ultra HD à 60 FPS sans coupure</strong> grâce à nos serveurs CDN suisses.
            </p>
          </div>

          <!-- Quick Controls Bar -->
          <div class="flex flex-wrap items-center gap-3 shrink-0">
            <button
              id="mc-refresh-btn"
              type="button"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#12141D] hover:bg-[#181B28] border border-white/10 text-xs font-semibold text-gray-200 transition-all cursor-pointer shadow-lg active:scale-95"
            >
              <RefreshCw class="w-4 h-4 text-emerald-400" id="mc-refresh-icon" />
              <span>Actualiser les Scores</span>
            </button>

            <a
              href="https://wa.me/213550592200?text=Bonjour%2C%20je%20souhaite%20d%C3%A9marrer%20mon%20essai%20gratuit%20de%2024h%20pour%20regarder%20le%20sport%20en%204K%20sur%20IPTV%20Suisse."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#DC2626] hover:bg-[#B91C1C] text-white text-xs font-bold transition-all shadow-xl shadow-red-900/30"
            >
              <Tv class="w-4 h-4" />
              <span>Tester le Flux Sport (24h Gratuit)</span>
            </a>
          </div>
        </div>

        <!-- Live Sync Status Strip -->
        <div class="flex flex-wrap items-center justify-between gap-4 py-3 px-4 rounded-xl bg-[#12141D]/80 border border-white/[0.06] text-xs text-gray-400">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span class="text-gray-300 font-medium">Flux de données synchronisé en temps réel</span>
            <span class="text-gray-600">·</span>
            <span id="mc-last-sync" class="text-gray-400 font-mono text-[11px]">Dernière mise à jour : instantanée</span>
          </div>

          <div class="flex items-center gap-4 text-[11px] font-mono">
            <span class="text-emerald-400 font-semibold">● CDN Genève: 8ms</span>
            <span class="text-emerald-400 font-semibold">● CDN Zürich: 11ms</span>
            <span class="text-amber-400 font-semibold">60 FPS Native</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Match Center Interactive Dashboard -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      
      <!-- Filter Category Buttons -->
      <div class="flex items-center gap-2 overflow-x-auto pb-4 scrollbar-none mb-8" id="category-filters">
        <button
          class="category-btn active px-4 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap cursor-pointer bg-[#DC2626] text-white shadow-lg shadow-red-900/20"
          data-category="all"
        >
          🔥 Tous les Matchs ({allMatches.length})
        </button>
        <button
          class="category-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all whitespace-nowrap cursor-pointer bg-[#12141D] text-gray-300 hover:text-white hover:bg-[#1A1D2B] border border-white/[0.06]"
          data-category="super-league"
        >
          ⚽ Super League ({allMatches.filter(m => m.category === 'super-league').length})
        </button>
        <button
          class="category-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all whitespace-nowrap cursor-pointer bg-[#12141D] text-gray-300 hover:text-white hover:bg-[#1A1D2B] border border-white/[0.06]"
          data-category="national-league"
        >
          🏒 National League Hockey ({allMatches.filter(m => m.category === 'national-league').length})
        </button>
        <button
          class="category-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all whitespace-nowrap cursor-pointer bg-[#12141D] text-gray-300 hover:text-white hover:bg-[#1A1D2B] border border-white/[0.06]"
          data-category="champions-league"
        >
          🏆 Champions League
        </button>
        <button
          class="category-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all whitespace-nowrap cursor-pointer bg-[#12141D] text-gray-300 hover:text-white hover:bg-[#1A1D2B] border border-white/[0.06]"
          data-category="ski"
        >
          ⛷️ Ski Alpin Wengen &amp; Adelboden
        </button>
      </div>

      <!-- Live Matches Grid -->
      <div id="matches-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {allMatches.map((match) => (
          <article 
            class="match-card rounded-2xl bg-[#12141D] border border-white/[0.08] hover:border-[#DC2626]/50 p-5 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-red-950/20 flex flex-col justify-between group"
            data-category={match.category}
            data-match-id={match.id}
          >
            <div>
              <!-- Top Row: Competition & Status -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[10px] font-bold uppercase tracking-wider bg-white/[0.05] text-gray-300 border border-white/[0.06]">
                  {match.badge}
                </span>

                {match.status === 'live' && (
                  <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#DC2626]/15 text-[#DC2626] border border-[#DC2626]/30 text-xs font-black animate-pulse">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#DC2626]"></span>
                    EN DIRECT
                  </span>
                )}
                {match.status === 'upcoming' && (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-400/10 text-amber-400 border border-amber-400/20 text-xs font-bold">
                    <Clock class="w-3 h-3" />
                    {match.timeOrDate}
                  </span>
                )}
                {match.status === 'finished' && (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-white/[0.06] text-gray-400 text-xs font-semibold">
                    OFFICIEL
                  </span>
                )}
              </div>

              <!-- League Label -->
              <p class="text-xs text-gray-400 font-medium mb-3">
                {match.league}
              </p>

              <!-- Scoreboard Card Area -->
              <div class="rounded-xl bg-[#0B0C10]/80 p-4 border border-white/[0.04] mb-4 space-y-3">
                <!-- Home Team -->
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="w-2 h-2 rounded-full bg-[#DC2626]/80 shrink-0"></span>
                    <span class="text-sm font-bold text-white truncate">
                      {match.homeTeam}
                    </span>
                  </div>
                  <span class="font-mono text-lg font-black text-white shrink-0">
                    {match.scoreHome !== null ? match.scoreHome : '-'}
                  </span>
                </div>

                <!-- Away Team -->
                <div class="flex items-center justify-between gap-3">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <span class="w-2 h-2 rounded-full bg-[#2563EB]/80 shrink-0"></span>
                    <span class="text-sm font-bold text-white truncate">
                      {match.awayTeam}
                    </span>
                  </div>
                  <span class="font-mono text-lg font-black text-white shrink-0">
                    {match.scoreAway !== null ? match.scoreAway : '-'}
                  </span>
                </div>
              </div>

              <!-- Venue & Details Info -->
              <div class="space-y-1.5 text-xs text-gray-400 mb-4">
                <div class="flex items-center gap-2 truncate">
                  <MapPin class="w-3.5 h-3.5 text-gray-500 shrink-0" />
                  <span class="truncate">{match.venue}</span>
                </div>
                <div class="flex items-center justify-between text-[11px] pt-1">
                  <span class="text-gray-400">{match.statusDetail}</span>
                  <span class="font-bold text-emerald-400 bg-emerald-950/40 border border-emerald-800/40 px-2 py-0.5 rounded">
                    {match.quality}
                  </span>
                </div>
              </div>
            </div>

            <!-- Card Action Button: Watch in 4K -->
            <a
              href={`https://wa.me/213550592200?text=Bonjour,%20je%20souhaite%20regarder%20le%20match%20${encodeURIComponent(match.homeTeam)}%20vs%20${encodeURIComponent(match.awayTeam)}%20en%204K%20sur%20IPTV%20Suisse.`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-white/[0.05] group-hover:bg-[#DC2626] text-gray-300 group-hover:text-white border border-white/[0.08] group-hover:border-[#DC2626] transition-all duration-300 text-xs font-bold"
            >
              <Play class="w-3.5 h-3.5 fill-current" />
              <span>Regarder en Direct 4K</span>
            </a>

          </article>
        ))}
      </div>

      <!-- Swiss League Standings Comparison Section -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16">
        
        <!-- Table 1: Super League Football -->
        <div class="rounded-3xl bg-[#12141D] border border-white/[0.08] p-6 sm:p-7">
          <div class="flex items-center justify-between gap-3 mb-6 pb-4 border-b border-white/[0.06]">
            <div>
              <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#DC2626] mb-1">
                <Trophy class="w-4 h-4 text-amber-400" />
                <span>Credit Suisse Super League 🇨🇭</span>
              </div>
              <h2 class="text-lg font-bold text-white">Classement Actuel</h2>
            </div>
            <span class="text-xs text-gray-400 font-mono">Saison {currentYear}</span>
          </div>

          <div class="overflow-x-auto">
