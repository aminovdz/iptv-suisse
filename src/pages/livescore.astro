<script is:inline>
  // Filter Tabs Handler
  const filterBtns = document.querySelectorAll('.category-btn');
  const matchCards = document.querySelectorAll('.match-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-[#DC2626]', 'text-white');
        b.classList.add('bg-[#12141D]', 'text-gray-300');
      });
      btn.classList.add('active', 'bg-[#DC2626]', 'text-white');
      btn.classList.remove('bg-[#12141D]', 'text-gray-300');

      const cat = btn.getAttribute('data-category');
      matchCards.forEach((card) => {
        if (cat === 'all' || card.getAttribute('data-category') === cat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Client-Side Live Score Polling from ESPN API
  async function refreshMatchCenter() {
    const icon = document.getElementById('mc-refresh-icon');
    const syncText = document.getElementById('mc-last-sync');
    if (icon) icon.classList.add('animate-spin');

    try {
      const res = await fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/sui.1/scoreboard");
      if (!res.ok) return;
      const data = await res.json();
      if (!data.events || !data.events.length) return;

      const footballCards = document.querySelectorAll('.match-card[data-category="super-league"]');
      data.events.slice(0, footballCards.length).forEach((ev, i) => {
        const card = footballCards[i];
        if (!card) return;
        const comp = ev.competitions && ev.competitions[0];
        if (!comp) return;
        const home = comp.competitors[0];
        const away = comp.competitors[1];

        const scoreEls = card.querySelectorAll('.font-mono.text-lg');
        if (scoreEls.length >= 2) {
          scoreEls[0].textContent = home.score !== undefined ? home.score : '-';
          scoreEls[1].textContent = away.score !== undefined ? away.score : '-';
        }
      });

      if (syncText) {
        const now = new Date();
        syncText.textContent = `Dernière mise à jour : ${now.toLocaleTimeString('fr-CH')}`;
      }
    } catch (e) {
      console.warn("Match center poll error:", e);
    } finally {
      if (icon) {
        setTimeout(() => icon.classList.remove('animate-spin'), 600);
      }
    }
  }

  document.getElementById('mc-refresh-btn')?.addEventListener('click', refreshMatchCenter);
  // Auto-refresh every 35s for live scores
  setInterval(refreshMatchCenter, 35000);
</script>
