---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { Gift, Share2, Sparkles, CheckCircle2, Trophy, ArrowRight, MessageCircle, Copy } from 'lucide-astro';

const pageTitle = "Programme de Parrainage Suisse | 1 Mois Offert - IPTV Suisse";
const pageDescription = "Parrainez vos proches en Suisse et gagnez 1 mois d'abonnement IPTV gratuit pour chaque filleul activé. Illimité et cumulable.";
const defaultShareUrl = "https://api.whatsapp.com/send?text=D%C3%A9couvre%20IPTV%20Suisse%20pour%20regarder%20toutes%20les%20cha%C3%AEnes%20suisses%20et%20le%20sport%20en%204K%20d%C3%A8s%20CHF%208.-%20%3A%20https%3A%2F%2Fiptvsuisse.it.com";
---

<Layout title={pageTitle} description={pageDescription} canonical="/referral">
  <StickyHeader />

  <main class="min-h-screen pt-32 pb-24 bg-[#0B0C10] text-gray-300">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Hero -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-bold uppercase tracking-wider mb-4">
          <Sparkles class="w-4 h-4 text-amber-400" />
          <span>Avantage Communauté Helvétique</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white tracking-tight mb-6">
          Parrainez un Proche, Recevez <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#EF4444]">1 Mois Offert</span>
        </h1>
        <p class="text-base sm:text-lg text-gray-300">
          Vous adorez votre expérience IPTV Suisse ? Partagez-la avec vos amis et collègues à Genève, Lausanne, Zürich ou Neuchâtel. Chaque recommandation récompensée !
        </p>
      </div>

      <!-- Highlight Banner -->
      <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-[#161926] via-[#11131C] to-[#161926] border border-white/[0.08] relative overflow-hidden mb-16 shadow-2xl">
        <div class="absolute top-0 right-0 w-96 h-96 bg-[#DC2626]/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
          <div>
            <div class="w-14 h-14 rounded-2xl bg-[#DC2626]/20 border border-[#DC2626]/40 flex items-center justify-center text-[#DC2626] mb-6">
              <Gift class="w-8 h-8" />
            </div>
            <h2 class="text-2xl sm:text-3xl font-black text-white mb-4">
              Gagnant-Gagnant pour Chaque Suisse
            </h2>
            <p class="text-gray-300 text-sm sm:text-base leading-relaxed mb-6">
              Pour chaque nouvel ami qui souscrit un abonnement annuel ou semestriel grâce à vous :
            </p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3">
                <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
                <span><strong class="text-white">Vous recevez :</strong> +1 mois supplémentaire ajouté gratuitement à votre abonnement actif.</span>
              </li>
              <li class="flex items-start gap-3">
                <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
                <span><strong class="text-white">Votre filleul reçoit :</strong> +1 mois gratuit offert dès sa première commande.</span>
              </li>
              <li class="flex items-start gap-3">
                <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" />
                <span><strong class="text-white">Sans plafond :</strong> Parrainez 12 amis, obtenez 12 mois 100% gratuits !</span>
              </li>
            </ul>
          </div>

          <!-- Share Box -->
          <div class="rounded-2xl bg-[#0F111A] border border-white/[0.08] p-6 text-center">
            <Trophy class="w-10 h-10 text-amber-400 mx-auto mb-3" />
            <h3 class="text-lg font-bold text-white mb-2">Partagez Immédiatement</h3>
            <p class="text-xs text-gray-400 mb-6">
              Envoyez votre message d'invitation personnalisé à vos proches via WhatsApp :
            </p>

            <a
              href={defaultShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2.5 py-3.5 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-lg shadow-emerald-950/40 transition-all mb-3"
            >
              <Share2 class="w-4 h-4" />
              <span>Inviter sur WhatsApp</span>
            </a>

            <button
              type="button"
              id="copy-referral-btn"
              class="w-full flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-gray-300 font-medium text-xs transition-all"
            >
              <Copy class="w-3.5 h-3.5" />
              <span id="copy-btn-label">Copier le message d'invitation</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 3 Steps -->
      <div class="mb-16">
        <h2 class="text-2xl sm:text-3xl font-black text-white text-center mb-10">
          Comment Fonctionne le Parrainage ?
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-3xl bg-[#12141D] border border-white/[0.08]">
            <span class="w-10 h-10 rounded-2xl bg-[#DC2626]/20 border border-[#DC2626]/40 text-[#DC2626] font-black text-base flex items-center justify-center mb-4">
              1
            </span>
            <h3 class="text-lg font-bold text-white mb-2">Partagez votre Lien</h3>
            <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
              Transmettez votre référence client ou partagez directement le lien du site avec votre ami par message.
            </p>
          </div>

          <div class="p-6 rounded-3xl bg-[#12141D] border border-white/[0.08]">
            <span class="w-10 h-10 rounded-2xl bg-[#DC2626]/20 border border-[#DC2626]/40 text-[#DC2626] font-black text-base flex items-center justify-center mb-4">
              2
            </span>
            <h3 class="text-lg font-bold text-white mb-2">Votre Ami S'Abonne</h3>
            <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
              Lors de sa commande, votre proche mentionne votre nom ou votre e-mail dans la note de paiement ou au support WhatsApp.
            </p>
          </div>

          <div class="p-6 rounded-3xl bg-[#12141D] border border-white/[0.08]">
            <span class="w-10 h-10 rounded-2xl bg-[#DC2626]/20 border border-[#DC2626]/40 text-[#DC2626] font-black text-base flex items-center justify-center mb-4">
              3
            </span>
            <h3 class="text-lg font-bold text-white mb-2">Mois Offerts Crédités</h3>
            <p class="text-xs sm:text-sm text-gray-400 leading-relaxed">
              Nos opérateurs créditent instantanément 30 jours supplémentaires sur votre ligne et sur celle de votre filleul.
            </p>
          </div>
        </div>
      </div>

      <!-- FAQ Parrainage -->
      <div class="p-6 sm:p-8 rounded-3xl bg-[#12141D] border border-white/[0.08]">
        <h2 class="text-xl sm:text-2xl font-bold text-white mb-6">Questions Fréquentes sur le Parrainage</h2>
        <div class="space-y-4 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.04]">
            <h4 class="font-bold text-white mb-1">Y a-t-il une limite au nombre de filleuls ?</h4>
            <p class="text-gray-400">Aucune ! Si vous parrainez 12 personnes au cours de l'année, vous bénéficiez d'une année complète de service gratuit.</p>
          </div>
          <div class="p-4 rounded-xl bg-white/[0.02] border border-white/[0.04]">
            <h4 class="font-bold text-white mb-1">Mon filleul peut-il profiter du test 24h avant de s'engager ?</h4>
            <p class="text-gray-400">Oui tout à fait. Votre filleul peut tester le service gratuitement pendant 24h avant de valider son abonnement.</p>
          </div>
        </div>
      </div>

      <!-- CTA Bottom -->
      <div class="text-center mt-12">
        <a
          href="https://wa.me/18036582620?text=Bonjour,%20je%20souhaite%20valider%20un%20parrainage%20IPTV%20Suisse"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#DC2626] to-[#EF4444] text-white font-bold text-base shadow-xl shadow-red-900/30 hover:scale-[1.02] transition-transform"
        >
          <MessageCircle class="w-5 h-5" />
          <span>Déclarer un Filleul au Support</span>
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>

<script>
  const copyBtn = document.getElementById('copy-referral-btn');
  const btnLabel = document.getElementById('copy-btn-label');
  const textToShare = "Découvre IPTV Suisse pour regarder toutes les chaînes suisses et le sport en 4K dès CHF 8.- : https://iptvsuisse.it.com";

  if (copyBtn && btnLabel) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(textToShare);
        btnLabel.textContent = "Lien copié dans le presse-papier !";
        setTimeout(() => {
          btnLabel.textContent = "Copier le message d'invitation";
        }, 3000);
      } catch (err) {
        // Fallback
        btnLabel.textContent = "Copié !";
      }
    });
  }
</script>
