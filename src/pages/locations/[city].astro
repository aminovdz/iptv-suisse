const { city } = Astro.props;

const currentYear = new Date().getFullYear();
const pageTitle = `IPTV ${city.name} ${currentYear} — Meilleur Abonnement IPTV 4K à ${city.name} (${city.canton})`;
const pageDescription = `Abonnement IPTV à ${city.name} en 4K Ultra HD. Compatible fibre ${city.localIsp}. Chaînes suisses et sport en direct dès CHF 8`;
const pageKeywords = [
  `iptv ${city.name.toLowerCase()}`,
  `abonnement iptv ${city.name.toLowerCase()}`,
  `meilleur iptv ${city.name.toLowerCase()}`,
  `iptv ${city.canton.toLowerCase()}`,
  `iptv suisse 4k`,
  `iptv suisse`
];

const localSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `IPTV Suisse — Service Local ${city.name}`,
  "serviceType": "Télévision IPTV 4K par Internet",
  "provider": {
    "@type": "Organization",
    "name": "IPTV Suisse",
    "url": "https://iptvsuisse.it.com"
  },
  "areaServed": {
    "@type": "City",
    "name": city.name,
    "containedInPlace": {
      "@type": "AdministrativeArea",
      "name": city.canton
    }
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "CHF",
    "lowPrice": "8",
    "highPrice": "55",
    "offerCount": "4"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "1940",
    "bestRating": "5"
  }
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  canonical={`/locations/${city.slug}`}
  schema={localSchema}
>
  <StickyHeader />

  <main class="min-h-screen pt-28 bg-[#0B0C10] text-gray-200">
    <!-- 1. Local Hero with H1 and Geotargeted Copy -->
    <section class="py-16 md:py-24 relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
        <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-[#DC2626]/12 rounded-full blur-[140px]"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <!-- Canton Tag -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-black uppercase tracking-wider mb-6">
          <MapPin class="w-4 h-4 text-[#DC2626]" />
          <span>Zone Desservie : {city.name} — {city.canton} 🇨🇭</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black text-white tracking-tight leading-tight mb-6 max-w-4xl mx-auto">
          Abonnement IPTV 4K à <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#EF4444]">{city.name}</span> : Streaming Suisse Stable &amp; Haute Définition
        </h1>

        <p class="text-base sm:text-lg text-gray-300 max-w-3xl mx-auto font-normal leading-relaxed mb-8">
          {city.leadText}
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
          <a
            href="#pricing"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#DC2626] to-[#EF4444] text-white font-black text-base shadow-xl shadow-red-900/30 hover:scale-[1.02] transition-transform"
          >
            <span>Activer à {city.name} (dès CHF 8)</span>
            <ArrowRight class="w-5 h-5" />
          </a>

          <a
            href={`https://wa.me/18036582620?text=Bonjour,%20je%20souhaite%20un%20test%20IPTV%20pour%20${encodeURIComponent(city.name)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-2xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.12] text-white font-bold text-base transition-colors"
          >
            <MessageCircle class="w-5 h-5 text-emerald-400" />
            <span>Essai 24h Gratuit WhatsApp</span>
          </a>
        </div>

        <!-- Fiber Network Illustration with Alt Text -->
        <div class="max-w-3xl mx-auto mb-12">
          <img
            src="/images/swiss-fiber-network.svg"
            alt={`Infrastructure réseau fibre optique haute vitesse compatible IPTV Suisse à ${city.name}`}
            class="w-full h-auto rounded-2xl border border-white/10 shadow-2xl"
            width="800"
            height="450"
            loading="lazy"
          />
        </div>

        <!-- Local Network & ISP Features -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-4xl mx-auto text-left">
          <div class="p-5 rounded-2xl bg-[#12141D] border border-white/[0.06]">
            <div class="flex items-center gap-2 text-[#60A5FA] font-bold text-sm mb-1">
              <Wifi class="w-4 h-4" />
              <span>Réseau Local Dédié</span>
            </div>
            <p class="text-xs text-gray-300">Optimisé pour la fibre {city.localIsp}.</p>
          </div>

          <div class="p-5 rounded-2xl bg-[#12141D] border border-white/[0.06]">
            <div class="flex items-center gap-2 text-amber-400 font-bold text-sm mb-1">
              <Trophy class="w-4 h-4" />
              <span>Clubs &amp; Équipes</span>
            </div>
            <p class="text-xs text-gray-300">Vivez chaque match de {city.teams} en direct 60 FPS.</p>
          </div>

          <div class="p-5 rounded-2xl bg-[#12141D] border border-white/[0.06]">
            <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm mb-1">
              <ShieldCheck class="w-4 h-4" />
              <span>Confidentialité nLPD</span>
            </div>
            <p class="text-xs text-gray-300">Streaming privé protégé conforme au droit suisse (LDA Art. 19).</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Features Grid (Anti-Freeze 9.8™, Swiss ISP bypass) -->
    <FeatureGrid />

    <!-- 3. Pricing Card (12-Month CHF 55 first, NO TWINT) -->
    <PricingCard />

    <!-- 4. Referrer (1 Mois Offert) -->
    <ReferralBanner />

    <!-- 5. Testimonials & Verified Reviews -->
    <UserReviewsSection />

    <!-- 6. Setup in 3 steps -->
    <ProcessSteps />

    <!-- 7. Compatible Devices -->
    <SupportedDevices />

    <!-- 8. Other Swiss Cities Grid for Internal Linking -->
    <CitiesList />

    <!-- 9. Contact Form -->
    <ContactForm />

    <!-- 10. FAQ -->
    <FAQSection />

    <!-- 11. Final CTA -->
    <CTASection />
  </main>

  <Footer />
  <FloatingWhatsApp />
  <SocialPopup />
  <ExitPopup />
  <GroupsPopup />
</Layout>
