---
import { MessageCircle, ShieldCheck } from 'lucide-astro';

const whatsappDirectUrl = "https://wa.me/18036582620?text=Bonjour%2C%20je%20souhaite%20des%20renseignements%20sur%20les%20abonnements%20IPTV%20Suisse.";
---

<!-- Floating WhatsApp Support Widget -->
<div class="fixed bottom-6 right-6 z-40 flex items-center gap-3">
  
  <!-- Tooltip Message Bubble (Desktop) -->
  <div class="hidden md:flex items-center gap-2 bg-[#12141D] border border-white/[0.1] text-gray-200 px-4 py-2 rounded-2xl shadow-xl backdrop-blur-xl text-xs font-semibold animate-pulse">
    <ShieldCheck class="w-4 h-4 text-emerald-400" />
    <span>Support Suisse 24/7 en ligne</span>
  </div>

  <!-- WhatsApp Floating Trigger Button -->
  <a
    href={whatsappDirectUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="relative group w-14 h-14 rounded-2xl bg-[#25D366] hover:bg-[#1EBE5D] flex items-center justify-center text-white shadow-[0_8px_25px_rgba(37,211,102,0.4)] hover:shadow-[0_12px_35px_rgba(37,211,102,0.6)] transition-all duration-300 transform hover:scale-110 focus:outline-none focus:ring-4 focus:ring-[#25D366]/40"
    aria-label="Contacter le support client IPTV Suisse sur WhatsApp"
  >
    <!-- Ripple Ping Wave -->
    <span class="absolute -inset-1 rounded-2xl bg-[#25D366] opacity-40 animate-ping pointer-events-none"></span>

    <MessageCircle class="w-7 h-7 text-white fill-white stroke-none relative z-10" />
  </a>
</div>
