---
interface Props {
  title: string;
  description: string;
  keywords?: string | string[];
  image?: string;
  canonicalURL?: URL | string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  keywords,
  image = '/images/og-banner.svg',
  canonicalURL = Astro.url,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const defaultKeywords = "iptv suisse, iptv schweiz, iptv tv, meilleur iptv suisse, abonnement iptv suisse, iptv suisse romande, iptv genève, iptv lausanne, streaming 4k suisse, national league direct";
const keywordsString = Array.isArray(keywords) 
  ? keywords.join(', ') 
  : (keywords || defaultKeywords);

const siteUrl = 'https://iptvsuisse.it.com';
const fullCanonicalURL = typeof canonicalURL === 'string' ? canonicalURL : new URL(Astro.url.pathname, Astro.site || siteUrl).toString();
const ogImageUrl = new URL(image, Astro.site || siteUrl).toString();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
<meta name="generator" content="IPTV Suisse Core Engine" />
<meta name="theme-color" content="#0B0C10" />
<meta name="color-scheme" content="dark" />

<!-- SEO Canonical & Hreflang Tags (Swiss Trilingual & Global) -->
<link rel="canonical" href={fullCanonicalURL} />
<link rel="alternate" hreflang="fr-CH" href={fullCanonicalURL} />
<link rel="alternate" hreflang="de-CH" href={`${siteUrl}/iptv-schweiz`} />
<link rel="alternate" hreflang="it-CH" href={`${siteUrl}/iptv-svizzera`} />
<link rel="alternate" hreflang="fr" href={siteUrl} />
<link rel="alternate" hreflang="x-default" href={siteUrl} />

<!-- Custom Swiss Favicon & Device Icons (Zero Default Astro Icons) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.svg" />
<meta name="apple-mobile-web-app-title" content="IPTV Suisse" />
<meta name="application-name" content="IPTV Suisse" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywordsString} />
<meta name="author" content="IPTV Suisse" />
<meta name="publisher" content="IPTV Suisse" />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullCanonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content="IPTV Suisse" />
<meta property="og:locale" content="fr_CH" />
<meta property="og:locale:alternate" content="de_CH" />
<meta property="og:locale:alternate" content="it_CH" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter / X -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={fullCanonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- Performance Preconnect & Typography -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
