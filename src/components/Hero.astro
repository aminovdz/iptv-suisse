---
import { ShieldCheck, Zap, Star, CheckCircle2, ArrowRight, MessageCircle } from 'lucide-astro';

interface Props {
  headline?: string;
  subheadline?: string;
  cityName?: string;
}

const {
  cityName,
  headline = cityName 
    ? `IPTV Suisse à ${cityName} — Streaming 4K Ultra HD sans coupure` 
    : "IPTV Suisse — Streaming TV 4K Ultra HD sans coupure dès CHF 8",
  subheadline = cityName
    ? `Profitez du meilleur de l'IPTV Suisse à ${cityName} avec activation instantanée, technologie Anti-Freeze 9.8™, tous les matchs de National League en direct et assistance WhatsApp 24/7 en français.`
    : "Découvrez IPTV Suisse, votre solution de streaming haute définition en Suisse romande et dans toute la Confédération. Accédez à vos chaînes nationales suisses en français, allemand et italien, au hockey sur glace en direct, à la Coupe du monde de Ski Alpin et aux grands rendez-vous sportifs mondiaux en 4K Ultra HD à 60 FPS sans coupure."
} = Astro.props;

const whatsappTrialUrl = "https://wa.me/18036582620?text=Bonjour%2C%20je%20souhaite%20d%C3%A9marrer%20mon%20essai%20gratuit%20de%2024h%20pour%20IPTV%20Suisse.";
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden" aria-labelledby="hero-title">
  <!-- Background Grid & Swiss Glow Lighting Accents -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[850px] h-[420px] bg-gradient-to-b from-[#DC2626]/12 via-[#2563EB]/08 to-transparent rounded-full blur-[140px]"></div>
    <div class="absolute top-44 right-10 w-96 h-96 bg-[#DC2626]/08 rounded-full blur-[150px]"></div>
    <div class="absolute bottom-10 left-10 w-80 h-80 bg-[#2563EB]/06 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: High Conversion Copy & SEO H1 -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Live Trust Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#12141D] border border-[#DC2626]/30 shadow-[0_0_20px_rgba(220,38,38,0.15)] mb-6">
          <span class="flex h-2.5 w-2.5 relative">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#10B981] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#10B981]"></span>
          </span>
          <span class="text-xs font-semibold tracking-wide text-gray-200">
            Serveurs CDN Suisse en ligne · Latence réduite (99.9% Uptime)
          </span>
        </div>

        <!-- Single Page H1 Tag -->
        <h1 id="hero-title" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white leading-[1.12] mb-6">
          {headline.includes('IPTV Suisse') ? (
            <>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-100 to-gray-300">
                {headline.split('IPTV Suisse')[0]}
              </span>
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#EF4444] to-[#F59E0B]">
                IPTV Suisse
              </span>
              <span class="text-white">
                {headline.split('IPTV Suisse')[1]}
              </span>
            </>
          ) : (
            <span class="text-white">{headline}</span>
          )}
        </h1>

        <!-- High-Intent Opening Paragraph with Keyword Integration -->
        <p class="text-base sm:text-lg text-gray-300 leading-relaxed max-w-2xl mb-8 font-normal">
          {subheadline} Économisez jusqu'à <strong class="text-white font-semibold">CHF 800 par an</strong> par rapport aux abonnements de câble traditionnels (Swisscom TV, Sunrise). Sans contrat contraignant, compatible Smart TV, Fire Stick et smartphones.
        </p>

        <!-- Social Proof Stats Mini Strip -->
        <div class="grid grid-cols-3 gap-3 sm:gap-6 w-full max-w-lg mb-8 pb-6 border-b border-white/[0.08]">
          <div>
            <div class="flex items-center gap-1 text-[#F59E0B] text-sm sm:text-base font-bold">
              <Star class="w-4 h-4 fill-[#F59E0B]" />
              <span>4.9 / 5</span>
            </div>
            <p class="text-[11px] sm:text-xs text-gray-400 mt-0.5">1'940+ Avis Clients</p>
          </div>
          <div>
            <div class="text-white text-sm sm:text-base font-bold flex items-center gap-1">
              <Zap class="w-4 h-4 text-[#DC2626]" />
              <span>Anti-Freeze™</span>
            </div>
            <p class="text-[11px] sm:text-xs text-gray-400 mt-0.5">Zéro Puffer 60 FPS</p>
          </div>
          <div>
            <div class="text-white text-sm sm:text-base font-bold flex items-center gap-1">
              <ShieldCheck class="w-4 h-4 text-[#10B981]" />
              <span>24h Garantie</span>
            </div>
            <p class="text-[11px] sm:text-xs text-gray-400 mt-0.5">100% Remboursable</p>
          </div>
        </div>

        <!-- High Conversion Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-8">
          <a
            href="/#pricing"
            class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl text-base font-black text-white bg-gradient-to-r from-[#DC2626] via-[#EF4444] to-[#DC2626] shadow-[0_10px_30px_rgba(220,38,38,0.4)] hover:shadow-[0_15px_40px_rgba(220,38,38,0.6)] transition-all transform hover:-translate-y-0.5"
            aria-label="Choisir mon abonnement IPTV Suisse"
          >
            <span>Abonnements (dès CHF 8)</span>
            <ArrowRight class="w-5 h-5" />
          </a>

          <a
            href={whatsappTrialUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-2xl text-sm font-bold text-gray-200 bg-[#12141D] border border-white/[0.12] hover:bg-[#1A1E2B] hover:text-white hover:border-[#25D366]/50 transition-all shadow-lg shadow-black/40"
            aria-label="Tester 24h gratuitement sur WhatsApp"
          >
            <MessageCircle class="w-5 h-5 text-[#25D366]" />
            <span>Tester 24h sur WhatsApp</span>
          </a>
        </div>

        <!-- Trust Signals Pill Strip -->
        <div class="flex flex-wrap items-center gap-y-2 gap-x-4 text-xs text-gray-400 font-medium">
          <span class="flex items-center gap-1.5 text-gray-300">
            <CheckCircle2 class="w-4 h-4 text-[#10B981]" />
            Activation instantanée (moins de 2 min)
          </span>
          <span class="flex items-center gap-1.5 text-gray-300">
            <CheckCircle2 class="w-4 h-4 text-[#10B981]" />
            Sans engagement de durée
          </span>
          <span class="flex items-center gap-1.5 text-gray-300">
            <CheckCircle2 class="w-4 h-4 text-[#10B981]" />
            Paiement CB, PostFinance & Crypto
          </span>
        </div>

      </div>

      <!-- Right Column: Interactive Glassmorphism TV Dashboard Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer Glow Box -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-[#DC2626] to-[#2563EB] rounded-3xl blur-xl opacity-30 animate-pulse"></div>

          <!-- Glass Card -->
          <div class="relative rounded-3xl bg-[#12141D]/90 border border-white/[0.1] p-6 shadow-2xl backdrop-blur-xl">
            
            <!-- Card Header -->
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/[0.08]">
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-[#DC2626]"></div>
                <div class="w-3 h-3 rounded-full bg-[#F59E0B]"></div>
                <div class="w-3 h-3 rounded-full bg-[#10B981]"></div>
                <span class="text-xs font-bold text-gray-300 ml-1">IPTV Suisse Pro Player</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#10B981]/20 text-[#10B981] border border-[#10B981]/30">
                SERVEUR SUISSE ACTIF
              </span>
            </div>

            <!-- TV Screen Mockup -->
            <div class="relative rounded-2xl overflow-hidden bg-gradient-to-br from-[#181B28] to-[#0A0B10] border border-white/[0.06] p-5 mb-5 shadow-inner">
              <div class="flex items-center justify-between text-xs text-gray-400 mb-3">
                <span class="flex items-center gap-1 text-[#DC2626] font-bold">
                  <span class="w-2 h-2 rounded-full bg-[#DC2626] animate-ping"></span>
                  EN DIRECT 4K UHD
                </span>
                <span class="font-mono text-gray-400">60 FPS · Anti-Freeze 9.8™</span>
              </div>

              <div class="space-y-3">
                <div class="bg-[#1C2030]/80 rounded-xl p-3 border border-white/[0.05] flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#DC2626]/20 border border-[#DC2626]/30 flex items-center justify-center font-black text-xs text-[#DC2626]">
                      CH-FR
                    </div>
                    <div>
                      <p class="text-xs font-bold text-white">National League Hockey</p>
                      <p class="text-[10px] text-gray-400">Genève-Servette vs Lausanne HC</p>
                    </div>
                  </div>
                  <span class="text-[10px] font-bold px-2 py-1 rounded bg-[#2563EB]/20 text-[#2563EB] border border-[#2563EB]/30">
                    DIRECT
                  </span>
                </div>

                <div class="bg-[#1C2030]/80 rounded-xl p-3 border border-white/[0.05] flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-[#F59E0B]/20 border border-[#F59E0B]/30 flex items-center justify-center font-black text-xs text-[#F59E0B]">
                      CH-DE
                    </div>
                    <div>
                      <p class="text-xs font-bold text-white">Ski Alpin Coupe du Monde</p>
                      <p class="text-[10px] text-gray-400">Descente Hommes de Wengen</p>
                    </div>
                  </div>
                  <span class="text-[10px] font-bold px-2 py-1 rounded bg-[#10B981]/20 text-[#10B981] border border-[#10B981]/30">
                    4K HDR
                  </span>
                </div>

                <div class="bg-[#1C2030]/80 rounded-xl p-3 border border-white/[0.05] flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-white/10 border border-white/20 flex items-center justify-center font-black text-xs text-white">
                      CH-IT
                    </div>
                    <div>
                      <p class="text-xs font-bold text-white">Football Super League</p>
                      <p class="text-[10px] text-gray-400">Servette FC vs BSC Young Boys</p>
                    </div>
                  </div>
                  <span class="text-[10px] font-bold px-2 py-1 rounded bg-[#DC2626]/20 text-[#DC2626] border border-[#DC2626]/30">
                    60 FPS
                  </span>
                </div>
              </div>
            </div>

            <!-- Card Bottom Offer Highlight -->
            <div class="bg-gradient-to-r from-[#DC2626]/15 via-[#2563EB]/15 to-transparent rounded-2xl p-4 border border-[#DC2626]/30 flex items-center justify-between">
              <div>
                <span class="text-[10px] uppercase tracking-wider font-extrabold text-[#F59E0B] block">
                  Formule Recommandée
                </span>
                <span class="text-sm font-bold text-white">
                  12 Mois IPTV Suisse Complet
                </span>
              </div>
              <div class="text-right">
                <span class="text-2xl font-black text-white">CHF 55</span>
                <span class="text-[10px] text-gray-400 block">Soit CHF 4.58/mois</span>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
