---
import { ShoppingCart, KeyRound, PlayCircle, ArrowRight, MessageCircle, Sparkles } from 'lucide-astro';

const steps = [
  {
    number: "01",
    icon: ShoppingCart,
    title: "Sélectionnez Votre Forfait",
    description: "Choisissez la durée qui vous convient (1, 3, 6 ou 12 Mois) à prix net en Francs Suisses (CHF). Zéro contrat contraignant, zéro frais cachés.",
    highlight: "Dès CHF 8.-"
  },
  {
    number: "02",
    icon: KeyRound,
    title: "Réception Express en 2 Min",
    description: "Vos identifiants Xtream Codes et liens M3U vous sont directement envoyés via WhatsApp et e-mail avec notre guide d'installation pas à pas.",
    highlight: "Instantané"
  },
  {
    number: "03",
    icon: PlayCircle,
    title: "Lancez Vos Flux 4K Immédiats",
    description: "Ouvrez votre application favorite sur Smart TV, Fire Stick, Apple TV ou smartphone et profitez instantanément de vos chaînes en Ultra HD sans coupure.",
    highlight: "Anti-Freeze 9.8™"
  }
];

const whatsappTrialUrl = "https://wa.me/18036582620?text=Bonjour%2C%20j%27aimerais%20de%20l%27aide%20pour%20configurer%20mon%20acc%C3%A8s%20IPTV%20Suisse.";
---

<section class="py-20 md:py-32 bg-[#0B0C10] relative overflow-hidden" aria-labelledby="process-heading">
  <!-- Subtle Glow -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[350px] bg-gradient-to-r from-[#DC2626]/10 to-[#2563EB]/10 rounded-full blur-[140px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#2563EB]/10 border border-[#2563EB]/30 text-[#3B82F6] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
        <span>Installation Facile & Rapide</span>
      </div>

      <h2 id="process-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
        Comment Ça Marche en <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#EF4444]">3 Étapes Simples</span>
      </h2>

      <p class="text-gray-300 text-base sm:text-lg font-normal">
        Aucune connaissance technique requise. Votre accès est opérationnel en moins de 2 minutes sur n'importe quel écran.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
      {steps.map((step) => (
        <div class="relative rounded-3xl bg-[#12141D] border border-white/[0.08] p-8 hover:border-[#DC2626]/40 transition-all duration-300 hover:-translate-y-1 shadow-xl flex flex-col justify-between">
          
          <!-- Step Top Row -->
          <div>
            <div class="flex items-center justify-between mb-6">
              <div class="w-14 h-14 rounded-2xl bg-[#DC2626]/15 border border-[#DC2626]/30 flex items-center justify-center text-[#DC2626]">
                <step.icon class="w-7 h-7" />
              </div>
              <span class="font-black text-4xl text-white/[0.08] font-mono">
                {step.number}
              </span>
            </div>

            <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-[#DC2626]/10 text-[#DC2626] border border-[#DC2626]/20 mb-3">
              {step.highlight}
            </span>

            <h3 class="text-xl font-bold text-white mb-3">
              {step.title}
            </h3>

            <p class="text-gray-400 text-sm leading-relaxed">
              {step.description}
            </p>
          </div>

          <!-- Bottom Visual Connector Bar -->
          <div class="mt-8 pt-4 border-t border-white/[0.06] flex items-center justify-between text-xs text-gray-500 font-medium">
            <span>Étape {step.number} sur 03</span>
            <ArrowRight class="w-4 h-4 text-[#DC2626]" />
          </div>

        </div>
      ))}
    </div>

    <!-- Quick Help Strip -->
    <div class="mt-12 text-center">
      <p class="text-xs sm:text-sm text-gray-400">
        Besoin d'un coup de main pour installer votre application ? Notre support vous guide gratuitement pas à pas sur WhatsApp :
        <a href={whatsappTrialUrl} target="_blank" rel="noopener noreferrer" class="text-emerald-400 font-bold hover:underline ml-1 inline-flex items-center gap-1">
          <MessageCircle class="w-3.5 h-3.5" />
          <span>Assistance Configuration WhatsApp</span>
        </a>
      </p>
    </div>

  </div>
</section>
