---
import { Tv, Smartphone, Laptop, Cast, Monitor, Cpu, Sparkles, CheckCircle2 } from 'lucide-astro';

const devices = [
  {
    icon: Tv,
    name: "Smart TV",
    brands: "Samsung (Tizen), LG (webOS), Sony, Philips, TCL, Hisense",
    popularApps: "IBO Player, IPTV Smarters Pro, Smart IPTV, Nanomid",
    tag: "Téléviseurs Connectés"
  },
  {
    icon: Cast,
    name: "Amazon Fire TV Stick",
    brands: "Fire TV Stick 4K, Fire TV 4K Max, Fire TV Cube",
    popularApps: "TiviMate, IPTV Smarters Pro, XCIPTV, Downloader",
    tag: "Boîtier Recommandé"
  },
  {
    icon: Cpu,
    name: "Android TV & Box",
    brands: "Nvidia Shield TV, Xiaomi Mi Box S, Chromecast avec Google TV",
    popularApps: "TiviMate IPTV, Televizo, OTT Navigator",
    tag: "Ultra Fluide 60 FPS"
  },
  {
    icon: Smartphone,
    name: "Apple TV, iPhone & iPad",
    brands: "Apple TV 4K, iPhone 16 / 15 / 14 / 13, iPad Pro & Air (iOS 15+)",
    popularApps: "IPTVX, GSE Smart IPTV, Smarters Player Lite",
    tag: "Écosystème Apple"
  },
  {
    icon: Monitor,
    name: "Boîtiers MAG & Formuler",
    brands: "MAG 254, 322, 420, 524, Formuler Z8 / Z10 / Z11 Pro Max",
    popularApps: "Portail Stalker / Adresse MAC, MyTVOnline 2/3",
    tag: "Haute Stabilité"
  },
  {
    icon: Laptop,
    name: "Ordinateurs PC & Mac",
    brands: "Windows 11 / 10, Apple macOS (M1/M2/M3 & Intel), Linux",
    popularApps: "VLC Media Player, IPTV Smarters Desktop, Web Player",
    tag: "Visionnage Web"
  }
];
---

<section id="devices" class="py-20 md:py-32 bg-[#090A0F] relative overflow-hidden" aria-labelledby="devices-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#2563EB]/10 border border-[#2563EB]/30 text-[#3B82F6] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
        <span>100% Multi-Plateformes</span>
      </div>

      <h2 id="devices-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
        Compatible avec Tous Vos <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#EF4444]">Écrans & Applications</span>
      </h2>

      <p class="text-gray-300 text-base sm:text-lg font-normal">
        Aucun matériel imposé ni frais de location de décodeur. Utilisez votre équipement existant avec nos liens M3U et identifiants Xtream Codes haute vitesse.
      </p>
    </div>

    <!-- Devices Showcase Graphic -->
    <div class="mb-12 text-center">
      <div class="max-w-2xl mx-auto rounded-3xl overflow-hidden shadow-2xl border border-white/[0.08] bg-[#0E1018]/80 backdrop-blur-sm p-2 sm:p-4">
        <img
          src="/images/app-devices.svg"
          alt="Équipements et applications compatibles IPTV Suisse en 4K Ultra HD"
          width="800"
          height="500"
          loading="lazy"
          class="w-full h-auto rounded-2xl mx-auto"
        />
      </div>
    </div>

    <!-- Devices Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {devices.map((device) => (
        <div class="rounded-2xl bg-[#12141D] border border-white/[0.08] p-6 sm:p-7 hover:border-[#DC2626]/40 transition-all duration-300 hover:-translate-y-1 shadow-lg flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-5">
              <div class="w-12 h-12 rounded-xl bg-[#DC2626]/15 border border-[#DC2626]/30 flex items-center justify-center text-[#DC2626]">
                <device.icon class="w-6 h-6" />
              </div>
              <span class="text-[10px] font-bold px-2.5 py-1 rounded-full bg-white/[0.06] text-gray-300 border border-white/[0.08]">
                {device.tag}
              </span>
            </div>

            <h3 class="text-lg font-bold text-white mb-2">
              {device.name}
            </h3>

            <p class="text-xs text-gray-400 mb-4 leading-relaxed">
              <strong class="text-gray-300">Modèles supportés :</strong> {device.brands}
            </p>
          </div>

          <div class="pt-4 border-t border-white/[0.06] text-xs">
            <span class="font-semibold text-emerald-400 block mb-1">Applications recommandées :</span>
            <span class="text-gray-400">{device.popularApps}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Free Tutorial Callout -->
    <div class="mt-12 text-center">
      <div class="inline-flex items-center gap-2 text-xs sm:text-sm text-gray-400 bg-[#12141D] border border-white/[0.08] px-5 py-2.5 rounded-full">
        <CheckCircle2 class="w-4 h-4 text-[#10B981]" />
        <span>Tutoriels pas à pas et liens de téléchargement fournis pour chaque application dès validation de votre commande.</span>
      </div>
    </div>

  </div>
</section>
