---
import { Mail, MessageCircle, Send, Clock, ShieldCheck, CheckCircle2, Sparkles } from 'lucide-astro';

const whatsappUrl = "https://wa.me/18036582620?text=Bonjour%2C%20je%20vous%20contacte%20depuis%20le%20formulaire%20du%20site%20IPTV%20Suisse.";
const whatsappChannelUrl = "https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v";
const telegramChannelUrl = "https://t.me/castvera_com";
---

<section id="contact" class="py-20 md:py-32 bg-[#090A0F] relative overflow-hidden" aria-labelledby="contact-heading">
  <!-- Glowing Background Accent -->
  <div class="absolute inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute bottom-10 right-1/4 w-[600px] h-[300px] bg-gradient-to-r from-[#DC2626]/10 via-[#2563EB]/05 to-transparent rounded-full blur-[140px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#DC2626]/10 border border-[#DC2626]/30 text-[#DC2626] text-xs font-bold uppercase tracking-wider mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
        <span>Assistance & Support Dédié</span>
      </div>

      <h2 id="contact-heading" class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight mb-4">
        Contactez le Support <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#EF4444]">IPTV Suisse</span>
      </h2>

      <p class="text-gray-300 text-base sm:text-lg font-normal">
        Une question technique, une demande de test 24h ou une assistance de configuration ? Nos conseillers francophones vous répondent 7j/7.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Contact Channels & Credentials -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- WhatsApp Direct Card -->
        <div class="rounded-3xl bg-gradient-to-br from-[#121B17] to-[#0E1412] border border-[#25D366]/30 p-6 sm:p-7 shadow-xl">
          <div class="flex items-center gap-4 mb-4">
            <div class="w-12 h-12 rounded-2xl bg-[#25D366]/20 border border-[#25D366]/40 flex items-center justify-center text-[#25D366] shrink-0">
              <MessageCircle class="w-6 h-6" />
            </div>
            <div>
              <h3 class="text-lg font-bold text-white">WhatsApp Support Direct</h3>
              <p class="text-xs text-emerald-400 font-semibold">Réponse sous 15 minutes</p>
            </div>
          </div>
          <p class="text-xs text-gray-300 leading-relaxed mb-5">
            Le moyen le plus rapide pour obtenir vos codes de test 24h, finaliser une commande ou être guidé pas à pas pour installer votre lecteur.
          </p>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-4 rounded-xl text-xs sm:text-sm font-bold bg-[#25D366] hover:bg-[#1EBE5D] text-black transition-all shadow-lg shadow-green-900/20"
          >
            <MessageCircle class="w-4 h-4" />
            <span>Écrire sur WhatsApp (+1 803 658-2620)</span>
          </a>
        </div>

        <!-- Official Channels & Emails Box -->
        <div class="rounded-3xl bg-[#12141D] border border-white/[0.08] p-6 sm:p-7 space-y-5">
          <h4 class="text-sm font-bold text-white uppercase tracking-wider border-b border-white/[0.08] pb-3">
            Canaux & Adresses Officielles
          </h4>

          <!-- Email 1 -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#DC2626]/15 border border-[#DC2626]/30 flex items-center justify-center text-[#DC2626] shrink-0 mt-0.5">
              <Mail class="w-4 h-4" />
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">Contact Général & Commandes</p>
              <a href="mailto:contact@iptvsuisse.it.com" class="text-sm font-bold text-white hover:text-[#DC2626] transition-colors">
                contact@iptvsuisse.it.com
              </a>
            </div>
          </div>

          <!-- Email 2 -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#2563EB]/15 border border-[#2563EB]/30 flex items-center justify-center text-[#2563EB] shrink-0 mt-0.5">
              <Mail class="w-4 h-4" />
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">Support Technique CastVera</p>
              <a href="mailto:support@castvera.com" class="text-sm font-bold text-white hover:text-[#2563EB] transition-colors">
                support@castvera.com
              </a>
            </div>
          </div>

          <!-- Telegram Channel -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#229ED9]/15 border border-[#229ED9]/30 flex items-center justify-center text-[#229ED9] shrink-0 mt-0.5">
              <Send class="w-4 h-4" />
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">Canal Officiel Telegram</p>
              <a href={telegramChannelUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-[#229ED9] hover:underline">
                t.me/castvera_com
              </a>
            </div>
          </div>

          <!-- WhatsApp Channel -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-[#25D366]/15 border border-[#25D366]/30 flex items-center justify-center text-[#25D366] shrink-0 mt-0.5">
              <MessageCircle class="w-4 h-4" />
            </div>
            <div>
              <p class="text-xs text-gray-400 font-medium">Chaîne Publique WhatsApp</p>
              <a href={whatsappChannelUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-bold text-[#25D366] hover:underline">
                Chaîne WhatsApp Officielle
              </a>
            </div>
          </div>

          <!-- Guarantees Strip -->
          <div class="pt-4 border-t border-white/[0.06] text-xs text-gray-400 space-y-1.5">
            <div class="flex items-center gap-2">
              <Clock class="w-3.5 h-3.5 text-[#F59E0B]" />
              <span>Horaires de support : 7j/7 de 08h00 à 23h00 (Heure suisse CET)</span>
            </div>
            <div class="flex items-center gap-2">
              <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
              <span>Données strictement confidentielles · Zéro partage tiers</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl bg-[#12141D] border border-white/[0.08] p-6 sm:p-10 shadow-2xl">
          
          <h3 class="text-xl font-bold text-white mb-2">
            Envoyer un Message
          </h3>
          <p class="text-xs text-gray-400 mb-6">
            Remplissez ce formulaire et notre équipe vous recontactera immédiatement par e-mail ou WhatsApp.
          </p>

          <form id="contact-form" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-name" class="block text-xs font-semibold text-gray-300 mb-1.5">
                  Nom & Prénom *
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="Ex: Marc Bonjour"
                  class="w-full px-4 py-3 rounded-xl bg-[#090A0F] border border-white/[0.1] text-white text-xs focus:border-[#DC2626] focus:outline-none focus:ring-1 focus:ring-[#DC2626] transition-colors"
                />
              </div>

              <div>
                <label for="contact-email" class="block text-xs font-semibold text-gray-300 mb-1.5">
                  Adresse E-mail *
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="votre-nom@domaine.ch"
                  class="w-full px-4 py-3 rounded-xl bg-[#090A0F] border border-white/[0.1] text-white text-xs focus:border-[#DC2626] focus:outline-none focus:ring-1 focus:ring-[#DC2626] transition-colors"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-device" class="block text-xs font-semibold text-gray-300 mb-1.5">
                  Appareil Utilisé
                </label>
                <select
                  id="contact-device"
                  name="device"
                  class="w-full px-4 py-3 rounded-xl bg-[#090A0F] border border-white/[0.1] text-gray-300 text-xs focus:border-[#DC2626] focus:outline-none focus:ring-1 focus:ring-[#DC2626] transition-colors"
                >
                  <option value="smart-tv">Smart TV (Samsung, LG, Sony)</option>
                  <option value="fire-stick">Amazon Fire TV Stick</option>
                  <option value="apple-tv">Apple TV / iPhone / iPad</option>
                  <option value="android-box">Android TV / Box / Smartphone</option>
                  <option value="mag">Boîtier MAG / Formuler</option>
                  <option value="pc">PC Windows / Mac</option>
                  <option value="other">Autre équipement</option>
                </select>
              </div>

              <div>
                <label for="contact-subject" class="block text-xs font-semibold text-gray-300 mb-1.5">
                  Objet de la demande
                </label>
                <select
                  id="contact-subject"
                  name="subject"
                  class="w-full px-4 py-3 rounded-xl bg-[#090A0F] border border-white/[0.1] text-gray-300 text-xs focus:border-[#DC2626] focus:outline-none focus:ring-1 focus:ring-[#DC2626] transition-colors"
                >
                  <option value="trial">Demande de test 24h gratuit</option>
                  <option value="order">Question sur ma commande</option>
                  <option value="setup">Aide à la configuration</option>
                  <option value="renew">Renouvellement d'abonnement</option>
                  <option value="other">Autre demande</option>
                </select>
              </div>
            </div>

            <div>
              <label for="contact-message" class="block text-xs font-semibold text-gray-300 mb-1.5">
                Votre Message *
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                required
                placeholder="Indiquez ici vos précisions, vos questions ou votre numéro WhatsApp..."
                class="w-full px-4 py-3 rounded-xl bg-[#090A0F] border border-white/[0.1] text-white text-xs focus:border-[#DC2626] focus:outline-none focus:ring-1 focus:ring-[#DC2626] transition-colors resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              class="w-full py-4 px-6 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-[#DC2626] to-[#EF4444] hover:from-[#B91C1C] hover:to-[#DC2626] shadow-lg shadow-red-900/30 transition-all hover:scale-[1.01] flex items-center justify-center gap-2"
            >
              <Send class="w-4 h-4" />
              <span>Transmettre ma demande au support suisse</span>
            </button>

            <!-- Success Alert Placeholder -->
            <div id="contact-success" class="hidden p-4 rounded-xl bg-emerald-950/40 border border-emerald-800/50 text-emerald-400 text-xs text-center">
              <CheckCircle2 class="w-4 h-4 inline mr-1 text-emerald-400" />
              <span>Merci ! Votre message a bien été transmis. Notre équipe vous répondra dans les plus brefs délais.</span>
            </div>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('contact-success');

  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Visual feedback without external dependencies
      form.reset();
      successBox.classList.remove('hidden');
      setTimeout(() => {
        successBox.classList.add('hidden');
      }, 7000);
    });
  }
</script>
