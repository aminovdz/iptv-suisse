---
import { Tv, Mail, MessageCircle, Send, MapPin, ShieldCheck } from 'lucide-astro';

const currentYear = new Date().getFullYear();

const cities = [
  { name: 'Genève', slug: 'geneve', canton: 'GE', region: 'Romande' },
  { name: 'Lausanne', slug: 'lausanne', canton: 'VD', region: 'Romande' },
  { name: 'Zürich', slug: 'zurich', canton: 'ZH', region: 'Deutschschweiz' },
  { name: 'Basel', slug: 'basel', canton: 'BS', region: 'Deutschschweiz' },
  { name: 'Bern', slug: 'bern', canton: 'BE', region: 'Deutschschweiz' },
  { name: 'Lugano', slug: 'lugano', canton: 'TI', region: 'Svizzera Italiana' },
  { name: 'Fribourg', slug: 'fribourg', canton: 'FR', region: 'Romande' },
  { name: 'Neuchâtel', slug: 'neuchatel', canton: 'NE', region: 'Romande' },
  { name: 'Sion', slug: 'sion', canton: 'VS', region: 'Romande' },
  { name: 'Luzern', slug: 'luzern', canton: 'LU', region: 'Deutschschweiz' },
  { name: 'St. Gallen', slug: 'st-gallen', canton: 'SG', region: 'Deutschschweiz' },
  { name: 'Biel / Bienne', slug: 'biel', canton: 'BE', region: 'Bilingue' }
];

const quickLinks = [
  { name: 'Accueil', href: '/' },
  { name: 'IPTV Sport 4K Direct', href: '/iptv-sport-suisse' },
  { name: 'Alternative Box & Câble', href: '/alternative-cable-tv-suisse' },
  { name: 'Nos Tarifs en CHF', href: '/#pricing' },
  { name: 'Programme Parrainage', href: '/referral' },
  { name: 'Contact & Support', href: '/contact' }
];

const guidesLinks = [
  { name: "L'IPTV est-il légal en Suisse ? (Art. 19 LDA)", href: '/guides/legalite-iptv-suisse-lda-art-19' },
  { name: 'Regarder la National League de Hockey en 4K', href: '/guides/regarder-national-league-hockey-suisse-iptv' },
  { name: 'Guide installation Smart TV Samsung & LG', href: '/guides/installer-iptv-smart-tv-samsung-lg-suisse' },
  { name: 'Tous nos guides & tutoriels', href: '/guides' }
];

const comparisons = [
  { name: 'IPTV Suisse vs Swisscom (blue TV)', href: '/compare/iptv-suisse-vs-swisscom-blue-tv' },
  { name: 'IPTV Suisse vs Sunrise TV', href: '/compare/iptv-suisse-vs-sunrise-tv' },
  { name: 'IPTV Suisse vs Salt TV', href: '/compare/iptv-suisse-vs-salt-tv' },
  { name: 'IPTV Suisse vs Revendeurs Génériques', href: '/compare/iptv-suisse-vs-competiteurs-generiques' }
];

const legalLinks = [
  { name: 'Politique de Confidentialité', href: '/privacy' },
  { name: 'Conditions Générales de Vente', href: '/terms' },
  { name: 'Politique de Remboursement (24h)', href: '/refund' },
  { name: 'Notice DMCA & Droits', href: '/dmca' },
  { name: 'Clause de Non-Responsabilité', href: '/disclaimer' }
];
---

<footer class="bg-[#07080D] border-t border-white/[0.08] text-gray-400 text-sm relative" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Pied de page IPTV Suisse</h2>

  <!-- Top Community & Channels Bar -->
  <div class="border-b border-white/[0.06] py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 bg-[#0E1018] rounded-2xl p-6 sm:p-8 border border-white/[0.06]">
        <div>
          <h3 class="text-xl font-bold text-white mb-2">
            Rejoignez notre communauté officielle en Suisse 🇨🇭
          </h3>
          <p class="text-gray-400 text-xs sm:text-sm max-w-xl">
            Suivez les alertes de diffusion des matchs en direct, les calendriers de National League et recevez une assistance immédiate via nos canaux officiels.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
          <a
            href="https://t.me/castvera_com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#229ED9]/15 text-[#229ED9] border border-[#229ED9]/30 hover:bg-[#229ED9]/25 transition-colors font-semibold text-xs"
            aria-label="Rejoindre le canal Telegram officiel"
          >
            <Send class="w-4 h-4" />
            <span>Canal Telegram</span>
          </a>
          <a
            href="https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30 hover:bg-[#25D366]/25 transition-colors font-semibold text-xs"
            aria-label="Rejoindre la chaîne WhatsApp officielle"
          >
            <MessageCircle class="w-4 h-4" />
            <span>Chaîne WhatsApp</span>
          </a>
          <a
            href="https://wa.me/18036582620"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-[#DC2626] text-white hover:bg-[#B91C1C] transition-colors font-bold text-xs"
            aria-label="Contacter le support client direct sur WhatsApp"
          >
            <span>Assistance Directe</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Links 4-Column Grid -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      
      <!-- Col 1: Brand & Contact Info -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-[#DC2626]/20 border border-[#DC2626]/40 flex items-center justify-center">
            <Tv class="w-5 h-5 text-[#DC2626]" />
          </div>
          <span class="font-black text-xl text-white tracking-tight">
            IPTV <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] to-[#EF4444]">SUISSE</span>
          </span>
        </a>

        <p class="text-xs sm:text-sm text-gray-400 leading-relaxed pr-6">
          IPTV Suisse est la plateforme de streaming 4K & 8K Ultra HD de référence en Suisse. Nœuds CDN locaux à Genève et Zürich, technologie Anti-Freeze 9.8™ et activation instantanée sans engagement.
        </p>

        <div class="space-y-2 pt-2 text-xs">
          <div class="flex items-center gap-2 text-gray-300">
            <Mail class="w-4 h-4 text-[#DC2626]" />
            <a href="mailto:contact@iptvsuisse.it.com" class="hover:text-white transition-colors">contact@iptvsuisse.it.com</a>
          </div>
          <div class="flex items-center gap-2 text-gray-300">
            <Mail class="w-4 h-4 text-[#2563EB]" />
            <a href="mailto:support@castvera.com" class="hover:text-white transition-colors">support@castvera.com</a>
          </div>
          <div class="flex items-center gap-2 text-gray-300">
            <MessageCircle class="w-4 h-4 text-[#25D366]" />
            <a href="https://wa.me/18036582620" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp : +1 (803) 658-2620</a>
          </div>
        </div>

        <!-- Payment Badges (Strictly zero TWINT) -->
        <div class="pt-4 border-t border-white/[0.06]">
          <p class="text-[11px] uppercase tracking-wider font-bold text-gray-400 mb-2">Moyens de paiement acceptés</p>
          <img
            src="/images/payment-methods.svg"
            alt="Moyens de paiement acceptés pour abonnement IPTV Suisse : Visa, Mastercard, PostFinance, Apple Pay, PayPal, Crypto"
            width="600"
            height="80"
            loading="lazy"
            class="w-full max-w-xs h-auto rounded-lg mb-3 border border-white/[0.08]"
          />
          <div class="flex flex-wrap gap-1.5 text-[10px] font-semibold text-gray-300">
            <span class="px-2 py-0.5 rounded bg-[#12141D] border border-white/[0.08]">Visa / Mastercard</span>
            <span class="px-2 py-0.5 rounded bg-[#12141D] border border-white/[0.08]">PostFinance</span>
            <span class="px-2 py-0.5 rounded bg-[#12141D] border border-white/[0.08]">Apple Pay</span>
            <span class="px-2 py-0.5 rounded bg-[#12141D] border border-white/[0.08]">PayPal</span>
            <span class="px-2 py-0.5 rounded bg-[#12141D] border border-white/[0.08]">Crypto (USDT / BTC)</span>
          </div>
        </div>
      </div>

      <!-- Col 2: Navigation Rapide -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-white/[0.08] pb-2">
          Navigation
        </h4>
        <ul class="space-y-2.5 text-xs">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white hover:underline transition-colors flex items-center justify-between">
                <span>{link.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Comparatifs & Alternatives -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-white/[0.08] pb-2">
          Comparatifs Câble
        </h4>
        <ul class="space-y-2.5 text-xs">
          {comparisons.map((item) => (
            <li>
              <a href={item.href} class="hover:text-[#DC2626] transition-colors flex items-center gap-1 group">
                <span class="group-hover:translate-x-1 transition-transform">→ {item.name}</span>
              </a>
            </li>
          ))}
        </ul>

        <h4 class="text-sm font-bold text-white uppercase tracking-wider mt-6 mb-4 border-b border-white/[0.08] pb-2">
          Guides & Tutoriels
        </h4>
        <ul class="space-y-2.5 text-xs">
          {guidesLinks.map((item) => (
            <li>
              <a href={item.href} class="hover:text-[#2563EB] transition-colors flex items-center gap-1 group">
                <span class="group-hover:translate-x-1 transition-transform">→ {item.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Légalité & Sécurité -->
      <div>
        <h4 class="text-sm font-bold text-white uppercase tracking-wider mb-4 border-b border-white/[0.08] pb-2">
          Informations Légales
        </h4>
        <ul class="space-y-2.5 text-xs">
          {legalLinks.map((item) => (
            <li>
              <a href={item.href} class="hover:text-white transition-colors flex items-center justify-between">
                <span>{item.name}</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-6 p-3.5 rounded-xl bg-[#12141D] border border-white/[0.06] text-[11px] text-gray-400">
          <div class="flex items-center gap-1.5 text-emerald-400 font-bold mb-1">
            <ShieldCheck class="w-3.5 h-3.5" />
            <span>Garantie 24h</span>
          </div>
          <p>Conformément à nos CGV, tout nouvel abonnement bénéficie d'une garantie de remboursement de 24 heures sans justification requise.</p>
        </div>
      </div>

    </div>

    <!-- Location Map & Geographic Cantons Grid (Programmatic SEO Interlinking) -->
    <div class="mt-12 pt-10 border-t border-white/[0.08]">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h4 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
            <MapPin class="w-4 h-4 text-[#DC2626]" />
            <span>Couverture Locale en Suisse — Villes & Cantons</span>
          </h4>
          <p class="text-xs text-gray-400 mt-1">Serveurs CDN et points d'accès haut débit dédiés par région géographique.</p>
        </div>
        <span class="text-xs text-emerald-400 font-semibold bg-emerald-950/40 border border-emerald-800/40 px-3 py-1 rounded-full w-fit">
          ● Nœuds CDN Actifs (GE, VD, ZH, BS, BE, TI)
        </span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 text-xs">
        {cities.map((city) => (
          <a
            href={`/locations/${city.slug}`}
            class="p-2.5 rounded-lg bg-[#0E1018] border border-white/[0.05] hover:border-[#DC2626]/40 hover:bg-[#151824] transition-all flex items-center justify-between group"
            title={`IPTV Suisse à ${city.name} (${city.canton})`}
          >
            <span class="text-gray-300 group-hover:text-white font-medium">{city.name}</span>
            <span class="text-[10px] font-bold text-[#DC2626] bg-[#DC2626]/10 px-1.5 py-0.5 rounded">
              {city.canton}
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom Copyright & Compliance Disclaimer -->
    <div class="mt-12 pt-8 border-t border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400 text-center sm:text-left">
      <p>
        © {currentYear} <strong>IPTV Suisse</strong> (<a href="https://iptvsuisse.it.com" class="text-gray-300 hover:underline">iptvsuisse.it.com</a>). Tous droits réservés.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 text-gray-400">
        <span>🇨🇭 Service optimisé pour la Suisse</span>
        <span>·</span>
        <span>Hébergement Cloudflare Edge</span>
        <span>·</span>
        <span>Support WhatsApp 24/7</span>
      </div>
    </div>
  </div>
</footer>
