---
import { Tv, MessageCircle, Menu, X, ArrowRight } from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { name: 'Accueil', href: '/' },
  { name: 'Avantages', href: '/#features' },
  { name: 'Tarifs', href: '/#pricing' },
  { name: 'Appareils', href: '/#devices' },
  { name: 'Villes', href: '/#cities' },
  { name: 'Guides', href: '/guides' },
  { name: 'Contact', href: '/contact' }
];

const whatsappTrialUrl = "https://wa.me/18036582620?text=Bonjour%2C%20je%20souhaite%20demander%20mon%20essai%20gratuit%20de%2024h%20pour%20IPTV%20Suisse.";
---

<header class="sticky top-0 z-50 w-full transition-all duration-300 bg-[#0B0C10]/90 backdrop-blur-xl border-b border-white/[0.08] shadow-[0_4px_30px_rgba(0,0,0,0.5)]">
  <!-- Top Promotion Ticker -->
  <div class="bg-gradient-to-r from-[#DC2626]/20 via-[#2563EB]/20 to-[#DC2626]/20 border-b border-[#DC2626]/25 text-center py-1.5 px-4 text-xs font-medium text-amber-300">
    <div class="flex items-center justify-center gap-2 max-w-7xl mx-auto flex-wrap sm:flex-nowrap">
      <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#DC2626] text-white uppercase tracking-wider">
        Offre Suisse
      </span>
      <span class="text-gray-200 text-[11px] sm:text-xs">
        Formule 12 Mois à seulement <strong class="text-white font-bold">CHF 55</strong> sans engagement ! Activation WhatsApp en 2 min
      </span>
      <a href="/#pricing" class="inline-flex items-center gap-1 text-[#F59E0B] hover:text-amber-200 hover:underline font-semibold ml-1 text-xs" aria-label="Profiter de l'offre IPTV Suisse">
        Voir l'offre <ArrowRight class="w-3 h-3" />
      </a>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#DC2626] rounded-lg p-1" aria-label="IPTV Suisse — Accueil">
        <div class="relative w-10 h-10 rounded-xl bg-gradient-to-br from-[#1A1D2B] to-[#0B0C10] border border-[#DC2626]/40 flex items-center justify-center shadow-[0_0_15px_rgba(220,38,38,0.25)] group-hover:border-[#DC2626] transition-colors">
          <Tv class="w-5 h-5 text-[#DC2626] group-hover:scale-110 transition-transform duration-300" />
          <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#10B981] ring-2 ring-[#0B0C10] animate-pulse"></span>
        </div>
        <div class="flex flex-col">
          <span class="font-black text-xl tracking-tight text-white flex items-center gap-1.5">
            IPTV <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#DC2626] via-[#EF4444] to-[#F59E0B]">SUISSE</span>
          </span>
          <span class="text-[10px] font-semibold uppercase tracking-widest text-gray-400 -mt-1">
            Qualité & Stabilité Suisse 🇨🇭
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navigation principale">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-2 text-sm font-medium rounded-lg transition-colors ${
              currentPath === link.href
                ? 'text-[#DC2626] bg-white/[0.05] font-semibold'
                : 'text-gray-300 hover:text-white hover:bg-white/[0.04]'
            }`}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Right Action & Language Selector -->
      <div class="hidden sm:flex items-center gap-3">
        <!-- Language indicator -->
        <div class="flex items-center bg-[#12141D] border border-white/[0.08] rounded-lg px-2.5 py-1 text-xs text-gray-300 font-semibold gap-1.5">
          <span class="text-white">🇨🇭 FR</span>
          <span class="text-gray-600">|</span>
          <a href="/locations/zurich" class="hover:text-white transition-colors" title="Deutschschweiz">DE</a>
          <span class="text-gray-600">|</span>
          <a href="/locations/lugano" class="hover:text-white transition-colors" title="Svizzera italiana">IT</a>
        </div>

        <a
          href={whatsappTrialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-[#25D366]/10 text-[#25D366] border border-[#25D366]/30 hover:bg-[#25D366]/20 transition-all"
          aria-label="Demander un test 24h gratuit sur WhatsApp"
        >
          <MessageCircle class="w-4 h-4" />
          <span>Test 24h</span>
        </a>

        <a
          href="/#pricing"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-[#DC2626] to-[#EF4444] hover:from-[#B91C1C] hover:to-[#DC2626] shadow-[0_4px_15px_rgba(220,38,38,0.3)] transition-all hover:scale-[1.02]"
          aria-label="Voir les abonnements IPTV Suisse"
        >
          <span>Abonnements</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex items-center gap-2 lg:hidden">
        <a
          href={whatsappTrialUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-lg bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30"
          aria-label="WhatsApp"
        >
          <MessageCircle class="w-5 h-5" />
        </a>

        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2.5 rounded-xl bg-[#12141D] border border-white/[0.08] text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#DC2626]"
          aria-label="Ouvrir le menu de navigation"
          aria-expanded="false"
        >
          <Menu class="w-6 h-6 block" id="menu-icon-open" />
          <X class="w-6 h-6 hidden" id="menu-icon-close" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#0D0F18] border-b border-white/[0.08] px-4 pt-3 pb-6">
    <div class="space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-lg text-base font-medium transition-colors ${
            currentPath === link.href
              ? 'text-[#DC2626] bg-white/[0.06] font-bold'
              : 'text-gray-300 hover:text-white hover:bg-white/[0.04]'
          }`}
        >
          {link.name}
        </a>
      ))}
    </div>

    <!-- Mobile Action Buttons -->
    <div class="pt-5 mt-4 border-t border-white/[0.08] space-y-3">
      <div class="flex items-center justify-between px-2 text-xs text-gray-400">
        <span>Régions linguistiques :</span>
        <div class="flex gap-2">
          <span class="font-bold text-[#DC2626]">Français 🇨🇭</span>
          <span>·</span>
          <a href="/locations/zurich" class="text-gray-300 hover:text-white">Deutsch</a>
          <span>·</span>
          <a href="/locations/lugano" class="text-gray-300 hover:text-white">Italiano</a>
        </div>
      </div>

      <a
        href="/#pricing"
        class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-[#DC2626] to-[#EF4444] shadow-lg shadow-red-900/30"
      >
        <span>Choisir un Abonnement (dès CHF 8)</span>
        <ArrowRight class="w-4 h-4" />
      </a>

      <a
        href={whatsappTrialUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 py-3 px-4 rounded-xl text-sm font-semibold bg-[#25D366]/15 text-[#25D366] border border-[#25D366]/30"
      >
        <MessageCircle class="w-4 h-4" />
        <span>Essai Gratuit 24h sur WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (toggleBtn && mobileMenu && openIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });

    // Close on link click
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
