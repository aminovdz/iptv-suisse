---
import { MapPin, ArrowRight, Sparkles } from 'lucide-astro';

interface City {
  name: string;
  slug: string;
  canton: string;
  population: string;
  region: string;
  description: string;
}

const cities: City[] = [
  {
    name: "Genève",
    slug: "geneve",
    canton: "Genève (GE)",
    population: "203'000 hab.",
    region: "Suisse Romande",
    description: "Nœud CDN local avec latence < 12ms. Diffusion haute vitesse des matchs du Genève-Servette et Servette FC."
  },
  {
    name: "Lausanne",
    slug: "lausanne",
    canton: "Vaud (VD)",
    population: "140'000 hab.",
    region: "Suisse Romande",
    description: "Accès optimisé Vaudois pour les derbies du Lausanne HC et les directs sportifs suisses sans coupure."
  },
  {
    name: "Zürich",
    slug: "zurich",
    canton: "Zürich (ZH)",
    population: "420'000 hab.",
    region: "Deutschschweiz",
    description: "Serveur primaire suisse allemand pour les rencontres des ZSC Lions et la Super League."
  },
  {
    name: "Basel",
    slug: "basel",
    canton: "Basel-Stadt (BS)",
    population: "178'000 hab.",
    region: "Deutschschweiz",
    description: "Infrastructures régionales connectées au SwissIX pour une fluidité 4K à 60 FPS ininterrompue."
  },
  {
    name: "Bern",
    slug: "bern",
    canton: "Bern (BE)",
    population: "134'000 hab.",
    region: "Capitale Fédérale",
    description: "Couverture totale de la région bernoise pour les matchs du SC Bern et BSC Young Boys."
  },
  {
    name: "Lugano",
    slug: "lugano",
    canton: "Tessin (TI)",
    population: "63'000 hab.",
    region: "Svizzera Italiana",
    description: "Serveur dédié pour le Tessin avec toutes les chaînes suisses italophones et les matchs passionnés du HC Lugano et HC Ambrì-Piotta."
  },
  {
    name: "Fribourg",
    slug: "fribourg",
    canton: "Fribourg (FR)",
    population: "38'000 hab.",
    region: "Bilingue FR/DE",
    description: "Streaming direct pour les fervents supporters du HC Fribourg-Gottéron."
  },
  {
    name: "Neuchâtel",
    slug: "neuchatel",
    canton: "Neuchâtel (NE)",
    population: "44'000 hab.",
    region: "Suisse Romande",
    description: "Bande passante non bridée sur tous les réseaux locaux pour un visionnage 4K instantané."
  },
  {
    name: "Sion",
    slug: "sion",
    canton: "Valais (VS)",
    population: "35'000 hab.",
    region: "Valais",
    description: "Idéal pour suivre la Coupe du monde de Ski Alpin en direct depuis les stations valaisannes."
  },
  {
    name: "Luzern",
    slug: "luzern",
    canton: "Luzern (LU)",
    population: "82'000 hab.",
    region: "Zentralschweiz",
    description: "Flux stabilisés Anti-Freeze 9.8™ pour la Suisse centrale."
  },
  {
    name: "St. Gallen",
    slug: "st-gallen",
    canton: "St. Gallen (SG)",
    population: "76'000 hab.",
    region: "Ostschweiz",
    description: "Connectivité optimale pour l'Est de la Suisse et le suivi des compétitions de Super League."
  },
  {
    name: "Biel / Bienne",
    slug: "biel",
    canton: "Bern (BE)",
