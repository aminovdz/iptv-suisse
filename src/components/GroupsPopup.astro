---
import { MessageCircle, Send, X, Bell, Sparkles } from 'lucide-astro';

const whatsappChannelUrl = "https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v";
const telegramChannelUrl = "https://t.me/castvera_com";
---

<!-- Community Channels Floating Modal -->
<div
  id="groups-popup"
  class="fixed bottom-24 right-6 z-40 hidden max-w-sm w-full rounded-3xl bg-[#12141D] border border-[#DC2626]/40 p-5 shadow-[0_15px_40px_rgba(0,0,0,0.7)] backdrop-blur-2xl transition-all duration-300 transform translate-y-10 opacity-0"
  role="region"
  aria-label="Canaux officiels IPTV Suisse"
>
  <!-- Close Button -->
  <button
    id="close-groups-popup"
    type="button"
    class="absolute top-3 right-3 p-1.5 rounded-full text-gray-400 hover:text-white bg-white/5 hover:bg-white/10 transition-colors focus:outline-none"
    aria-label="Fermer la notification des canaux"
  >
    <X class="w-4 h-4" />
  </button>

  <div class="flex items-center gap-3 mb-3">
    <div class="w-10 h-10 rounded-xl bg-[#DC2626]/20 border border-[#DC2626]/40 flex items-center justify-center text-[#DC2626]">
      <Bell class="w-5 h-5" />
    </div>
    <div>
      <div class="text-[11px] font-bold uppercase tracking-wider text-[#F59E0B] flex items-center gap-1">
        <Sparkles class="w-3 h-3" /> Communauté Officielle Suisse
      </div>
      <h3 class="text-sm font-bold text-white">Ne Manquez Aucun Match Suisse !</h3>
    </div>
  </div>

  <p class="text-xs text-gray-300 leading-relaxed mb-4">
    Rejoignez nos canaux pour recevoir le programme des matchs de National League, les alertes de serveurs et les promotions exclusives.
  </p>

  <div class="space-y-2">
    <!-- WhatsApp Channel Button -->
    <a
      href={whatsappChannelUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-[#25D366] hover:bg-[#1EBE5D] text-black text-xs font-black uppercase tracking-wider shadow-md transition-colors"
      aria-label="Rejoindre la chaîne WhatsApp IPTV Suisse"
    >
      <MessageCircle class="w-4 h-4" />
      <span>Rejoindre la Chaîne WhatsApp</span>
    </a>

    <!-- Telegram Channel Button -->
    <a
      href={telegramChannelUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-[#229ED9]/20 hover:bg-[#229ED9]/30 text-[#229ED9] border border-[#229ED9]/30 text-xs font-bold uppercase tracking-wider transition-colors"
      aria-label="Rejoindre le canal Telegram IPTV Suisse"
    >
      <Send class="w-4 h-4" />
      <span>Rejoindre le Canal Telegram</span>
    </a>
  </div>
</div>

<script>
  const GROUPS_STORAGE_KEY = 'iptv_suisse_groups_popup_seen';
  const TWENTY_FOUR_HOURS_MS = 24 * 60 * 60 * 1000;

  function shouldShowGroupsPopup() {
    try {
      const lastSeen = localStorage.getItem(GROUPS_STORAGE_KEY);
      if (!lastSeen) return true;
      return (Date.now() - parseInt(lastSeen, 10)) > TWENTY_FOUR_HOURS_MS;
    } catch (e) {
      return true;
    }
  }

  function markGroupsPopupSeen() {
    try {
      localStorage.setItem(GROUPS_STORAGE_KEY, Date.now().toString());
    } catch (e) {
      // ignore
    }
  }

  const groupsPopup = document.getElementById('groups-popup');
  const closeBtn = document.getElementById('close-groups-popup');

  function showPopup() {
    if (!shouldShowGroupsPopup() || !groupsPopup) return;
    markGroupsPopupSeen();

    groupsPopup.classList.remove('hidden');
    setTimeout(() => {
      groupsPopup.classList.remove('translate-y-10', 'opacity-0');
      groupsPopup.classList.add('translate-y-0', 'opacity-100');
    }, 50);
  }

  function hidePopup() {
    if (!groupsPopup) return;
    groupsPopup.classList.remove('translate-y-0', 'opacity-100');
    groupsPopup.classList.add('translate-y-10', 'opacity-0');
    setTimeout(() => {
      groupsPopup.classList.add('hidden');
    }, 300);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', hidePopup);
  }

  // Trigger after 10 seconds on page if user hasn't seen it in 24h
  if (shouldShowGroupsPopup()) {
    setTimeout(showPopup, 10000);
  }
</script>
