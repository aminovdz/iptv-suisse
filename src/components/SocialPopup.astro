---
import { CheckCircle2, Tv, X } from 'lucide-astro';
---

<!-- Social Proof Live Toast Widget -->
<div
  id="social-toast"
  class="fixed bottom-6 left-6 z-40 hidden sm:flex items-center gap-3.5 p-3.5 pr-4 rounded-2xl bg-[#12141D]/95 border border-[#DC2626]/40 shadow-[0_10px_30px_rgba(0,0,0,0.6)] backdrop-blur-xl transition-all duration-500 transform translate-y-20 opacity-0 max-w-sm pointer-events-auto"
  aria-live="polite"
>
  <div class="relative w-11 h-11 rounded-xl bg-gradient-to-br from-[#DC2626] to-[#991B1B] flex items-center justify-center text-white font-black text-sm shrink-0 shadow-md">
    <Tv class="w-5 h-5 text-white" />
    <span class="absolute -top-1 -right-1 w-3 h-3 rounded-full bg-[#10B981] ring-2 ring-[#12141D] animate-ping"></span>
  </div>

  <div class="space-y-0.5 flex-1 pr-2">
    <div class="flex items-center gap-1.5 text-xs font-bold text-white">
      <span id="toast-name">Marc B.</span>
      <span class="text-gray-400 font-normal">à</span>
      <span id="toast-city" class="text-amber-400 font-semibold">Genève</span>
    </div>
    <p id="toast-action" class="text-[11px] text-gray-300 font-medium leading-tight">
      A activé l'abonnement 12 Mois (CHF 55)
    </p>
    <div class="flex items-center gap-1 text-[10px] text-gray-500 font-medium pt-0.5">
      <CheckCircle2 class="w-3 h-3 text-[#10B981]" />
      <span id="toast-time">Il y a 3 minutes</span>
      <span>•</span>
      <span class="text-gray-400">Paiement Sécurisé</span>
    </div>
  </div>

  <!-- Quick Dismiss Button -->
  <button
    id="dismiss-social-toast"
    type="button"
    class="text-gray-400 hover:text-white p-1"
    aria-label="Fermer la notification"
  >
    <X class="w-3.5 h-3.5" />
  </button>
</div>

<script>
  const STORAGE_KEY = 'iptv_suisse_social_toast_dismissed';
  const TWENTY_FOUR_HOURS_MS = 24 * 60 * 60 * 1000;

  function isToastDismissed() {
    try {
      const dismissedTime = localStorage.getItem(STORAGE_KEY);
      if (!dismissedTime) return false;
      return (Date.now() - parseInt(dismissedTime, 10)) < TWENTY_FOUR_HOURS_MS;
    } catch (e) {
      return false;
    }
  }

  let loopInterval: number | null = null;
  let hideTimeout: number | null = null;

  function dismissToast() {
    try {
      localStorage.setItem(STORAGE_KEY, Date.now().toString());
    } catch (e) {
      // ignore
    }
    if (loopInterval) window.clearInterval(loopInterval);
    if (hideTimeout) window.clearTimeout(hideTimeout);
    hideNotification();
  }

  const recentSwissPurchases = [
    { name: "Marc B.", city: "Genève", action: "A activé l'abonnement 12 Mois (CHF 55)", time: "Il y a 3 minutes" },
    { name: "Sophie M.", city: "Lausanne", action: "A démarré un test gratuit 24h WhatsApp", time: "Il y a 6 minutes" },
    { name: "Christian Z.", city: "Zürich", action: "A renouvelé sa formule Ultra HD 4K", time: "Il y a 11 minutes" },
    { name: "David T.", city: "Neuchâtel", action: "A souscrit au pack 6 Mois (CHF 30)", time: "Il y a 14 minutes" },
    { name: "Alexandre P.", city: "Fribourg", action: "Streamt la National League sur Smart TV", time: "Il y a 19 minutes" },
    { name: "Luca R.", city: "Lugano", action: "A activé l'accès sur Apple TV 4K", time: "Il y a 23 minutes" }
  ];

  let currentIndex = 0;
  const toast = document.getElementById('social-toast');
  const nameEl = document.getElementById('toast-name');
  const cityEl = document.getElementById('toast-city');
  const actionEl = document.getElementById('toast-action');
  const timeEl = document.getElementById('toast-time');
  const dismissBtn = document.getElementById('dismiss-social-toast');

  function showNextNotification() {
    if (isToastDismissed() || !toast || !nameEl || !cityEl || !actionEl || !timeEl) return;

    const data = recentSwissPurchases[currentIndex];
    nameEl.textContent = data.name;
    cityEl.textContent = data.city;
    actionEl.textContent = data.action;
    timeEl.textContent = data.time;

    toast.classList.remove('translate-y-20', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');

    currentIndex = (currentIndex + 1) % recentSwissPurchases.length;

    hideTimeout = window.setTimeout(hideNotification, 5000);
  }

  function hideNotification() {
    if (!toast) return;
    toast.classList.remove('translate-y-0', 'opacity-100');
    toast.classList.add('translate-y-20', 'opacity-0');
  }

  if (dismissBtn) {
    dismissBtn.addEventListener('click', dismissToast);
  }

  if (!isToastDismissed()) {
    setTimeout(() => {
      showNextNotification();
      loopInterval = window.setInterval(showNextNotification, 18000);
    }, 4000);
  }
</script>
